def restore_only():
    """Pre-network boot path: block first, ask questions later.

    Runs from kiwi-killswitch-boot.service, ordered before network-pre.target,
    so if we were armed at shutdown the machine comes up already blocked —
    there is no window between a NIC gaining carrier and the daemon getting
    around to loading a ruleset. The full daemon replaces this with the real
    ruleset a moment later.

    The block is always built fresh from the config: /run does not survive a
    reboot, so there is never a saved one to reuse. And it tries twice — a
    hard block that keeps the management path, then the bare lockdown — because
    "the boot block failed to load" used to mean the network came up open.
    """
    cfg = Config()
    if not cfg["armed"]:
        return 0
    fw = Firewall(cfg)
    for name, build in (("hard block", lambda: fw.hard_block(cfg.settings())),
                        ("bare lockdown", fw.lockdown)):
        try:
            if nft_apply(build(), path=BOOT_RULESET):
                log(f"boot: {name} loaded")
                return 0
        except Exception as e:  # noqa: BLE001
            log(f"boot: {name} could not be built: {e}")
    log("boot: FAILED to load any block — the network will come up unfiltered")
    return 1


def panic():
    """Undo everything, as directly as possible, and stay out of the way.

    The recovery path for "I am locked out and the daemon may be wedged". It
    does not talk to the daemon over D-Bus — it stops it, tears the rules down
    itself, clears the persisted intent so a restart does not immediately
    re-block, and puts DNS and routing back. Then it starts the daemon again so
    the machine is left in a working, disarmed state rather than a half one.

    Root only, and it genuinely removes your protection. That is the point.
    """
    log("PANIC: removing all kill switch state")
    run(["systemctl", "stop", "kiwi-killswitchd.service"], timeout=60)
    nft_drop_tables()
    cfg = Config()
    ks = KillSwitch(cfg, None)
    try:
        ks._del_mgmt_routes()
        ks.dns.clear()
    except Exception as e:  # noqa: BLE001 — never let cleanup stop the teardown
        log(f"panic: cleanup error (continuing): {e}")
    cfg["armed"] = False
    cfg.unreadable = False
    cfg.save()
    nft_drop_tables()
    run(["systemctl", "start", "kiwi-killswitchd.service"], timeout=60)
    log("PANIC: done — this machine is NOT protected")
    return 0


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--restore-only", action="store_true",
                    help="load the pre-network hard block and exit (boot unit)")
    ap.add_argument("--panic", action="store_true",
                    help="tear everything down and leave the machine unprotected")
    args = ap.parse_args()

    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    if os.geteuid() != 0:
        log("must run as root")
        return 1
    os.makedirs(STATE_DIR, exist_ok=True)

    if args.restore_only:
        return restore_only()
    if args.panic:
        return panic()

    svc = Service()
    svc.start()
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
