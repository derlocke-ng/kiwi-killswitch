# ---------------------------------------------------------------------------
def run(cmd, **kw):
    """Run a helper and ALWAYS come back with a result.

    Everything here executes on the main loop, so a hung nmcli or resolvectl
    would freeze the daemon — and with it every D-Bus caller — for as long as it
    liked. A timeout turns that into one failed step. Output is decoded
    leniently for the same reason: a connection name that is not valid UTF-8
    must not be able to raise out of the middle of an apply."""
    kw.setdefault("timeout", SUBPROCESS_TIMEOUT)
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              errors="replace", **kw)
    except subprocess.TimeoutExpired:
        log(f"{cmd[0]} did not finish within {kw['timeout']}s")
        return subprocess.CompletedProcess(cmd, 124, "", "timeout")
    except OSError as e:
        log(f"cannot run {cmd[0]}: {e}")
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def log(msg):
    print(f"kiwi-killswitchd: {msg}", file=sys.stderr, flush=True)


_logged = set()


def log_once(key, msg):
    """For conditions that are re-observed on every apply and would otherwise
    bury the journal under the same line."""
    if key not in _logged:
        _logged.add(key)
        log(msg)


def nft_apply(ruleset, path=RUNTIME_RULESET):
    try:
        with open(path, "w") as fh:
            fh.write(ruleset)
    except OSError as e:
        log(f"cannot write {path}: {e}")
        return False
    r = run(["nft", "-f", path])
    if r.returncode != 0:
        log(f"nft error: {r.stderr.strip()}")
    return r.returncode == 0


def nft_drop_tables():
    for fam, tbl in (("inet", TABLE), ("netdev", NETDEV_TABLE)):
        run(["nft", "delete", "table", fam, tbl])


def nft_present(netdev=False):
    """Ground truth: is our main table actually loaded in the kernel?

    INVARIANT 4: `nft -f` is ONE transaction — a single bad line rolls the whole
    file back. If we were disarmed at the time that leaves no table at all, i.e.
    no firewall, while the UI happily reports 'armed'. Never trust the return
    code alone; ask the kernel."""
    if run(["nft", "list", "table", "inet", TABLE]).returncode != 0:
        return False
    return (not netdev
            or run(["nft", "list", "table", "netdev", NETDEV_TABLE]).returncode == 0)


def is_ipv6(a):
    return ":" in a


def is_literal_ip(a):
    """A bare IPv4/IPv6 address and nothing else.

    `ipaddress` accepts a zone suffix ("fe80::1%anything") and puts no limit on
    what follows the %, so on its own it would wave arbitrary text through to a
    ruleset. nft cannot use a scoped address anyway."""
    if not isinstance(a, str) or "%" in a:
        return False
    try:
        ipaddress.ip_address(a)
        return True
    except ValueError:
        return False


def norm_subnet(s):
    """Canonical CIDR for anything `ipaddress` can read, else "".

    Canonical, not merely valid: `ipaddress` happily takes a netmask
    ("192.168.0.0/255.255.0.0") that nft rejects, and ONE rejected token rolls
    the whole transaction back. Everything that reaches a ruleset goes through
    here, so nft only ever sees prefix notation."""
    if not isinstance(s, str) or "%" in s:
        return ""
    try:
        return str(ipaddress.ip_network(s.strip(), strict=False))
    except ValueError:
        return ""


def valid_subnet(s):
    return bool(norm_subnet(s))


def _tokens(text):
    return [t for t in re.split(r"[\s,]+", str(text or "")) if t]


def subnets_of(text):
    """The usable networks in a setting, canonical and de-duplicated. Lenient
    on purpose: this is the emit-side filter, and a bad token from an old
    config must be dropped, not allowed to break the ruleset."""
    return list(dict.fromkeys(n for n in map(norm_subnet, _tokens(text)) if n))


def valid_port(tok):
    return tok.isascii() and tok.isdigit() and 1 <= int(tok) <= 65535


def ports_of(text):
    """The usable port numbers in a setting. `str.isdigit()` alone is not
    enough: "99999" and "²" both pass it, and nft rejects both."""
    return list(dict.fromkeys(str(int(t)) for t in _tokens(text) if valid_port(t)))


# an endpoint must look like an IP or hostname (a dot or colon, only safe chars)
# — anything else is parser garbage and must NEVER reach nft
_EP_RE = re.compile(r"^[A-Za-z0-9._:\-]+$")


def valid_endpoint(ep):
    return bool(ep) and bool(_EP_RE.match(ep)) and ("." in ep or ":" in ep)


# The kernel allows almost anything in an interface name — quotes included —
# and nft reads a trailing * as a wildcard. A name is written into the ruleset
# inside double quotes, so only names that cannot end the string or change its
# meaning are accepted; anything else is treated as "no such exit" and blocks.
_IFACE_RE = re.compile(r"^[A-Za-z0-9_.@\-]{1,15}$")


def valid_iface(name):
    return isinstance(name, str) and bool(_IFACE_RE.match(name))


def nft_ident(name):
    """nft chain identifiers are not arbitrary strings — a vlan like 'eth0.10'
    or a bridge like 'br-lan' would not parse."""
    return re.sub(r"[^A-Za-z0-9_]", "_", name)


def truthy(v):
    return v in (True, 1, "1", "true", "True", "yes", "on")


def int_of(v, default):
    try:
        return int(str(v).strip())
    except ValueError:
        return default


_TRUE = ("1", "true", "yes", "on")
_FALSE = ("0", "false", "no", "off", "")
_HOST_RE = re.compile(r"^[A-Za-z0-9_]([A-Za-z0-9_.\-]{0,251}[A-Za-z0-9_])?\.?$")
_PATH_RE = re.compile(r"^/[A-Za-z0-9._~/\-]{0,200}$")
_MAC_RE = re.compile(r"^([0-9a-f]{2}:){5}[0-9a-f]{2}$")


def _has_ctl(s):
    return any(ord(c) < 32 or ord(c) == 127 for c in s)


def clean_setting(key, value):
    """Validate one setting and return it in the form it is stored in.

    Raises ValueError with a message meant for a person. Nothing is staged
    without passing through here. The bus policy lets every `wheel` process
    call us without a password, so a value is untrusted input — and a single
    malformed token in an nft file rolls back the whole transaction, which is
    how a typo in a port list once left an armed machine with no table at all.
    """
    v = str(value)
    if _has_ctl(v):
        raise ValueError(f"{key}: control characters are not allowed")
    if key == "vpn":
        # A NetworkManager connection name is nearly free-form and only ever
        # travels as one argv element — but a leading dash would be read as an
        # option by nmcli and wg.
        if len(v) > 128 or v.startswith("-"):
            raise ValueError("vpn: not a usable connection name")
        return v
    v = v.strip()
    if key in BOOLS:
        if v.lower() in _TRUE:
            return "1"
        if v.lower() in _FALSE:
            return "0"
        raise ValueError(f"{key} is a switch — use 1 or 0")
    if key in ("mode", "dns_mode", "hardening"):
        allowed = {"mode": MODES, "dns_mode": DNS_MODES,
                   "hardening": HARDENING_LEVELS}[key]
        if v not in allowed:
            raise ValueError(f"{key} must be one of {', '.join(allowed)}")
        return v
    if key in INT_RANGE:
        lo, hi = INT_RANGE[key]
        if not (v.isascii() and v.isdigit() and lo <= int(v) <= hi):
            raise ValueError(f"{key} must be a whole number from {lo} to {hi}")
        return str(int(v))
    if key == "dns_custom":
        if v and not is_literal_ip(v):
            raise ValueError(f"dns_custom: '{v}' is not an IP address")
        return str(ipaddress.ip_address(v)) if v else ""
    if key in ("bypass_subnets", "mgmt_subnets"):
        out = []
        for tok in _tokens(v):
            n = norm_subnet(tok)
            if not n:
                raise ValueError(f"{key}: '{tok}' is not a network — use CIDR, "
                                 "e.g. 192.168.1.0/24")
            out.append(n)
        return " ".join(dict.fromkeys(out))
    if key == "allow_in_ports":
        out = []
        for tok in _tokens(v):
            if not valid_port(tok):
                raise ValueError(f"allow_in_ports: '{tok}' is not a port (1-65535)")
            out.append(str(int(tok)))
        return " ".join(dict.fromkeys(out))
    if key == "doh_servers":
        out = []
        for tok in _tokens(v):
            ip, _, name = tok.partition("#")
            if not is_literal_ip(ip) or ("#" in tok and not _HOST_RE.match(name)):
                raise ValueError(f"doh_servers: '{tok}' must be an IP address, "
                                 "optionally followed by #hostname")
            out.append(tok)
        return " ".join(dict.fromkeys(out))
    if key == "doh_path":
        v = v or "/dns-query"
        if not _PATH_RE.match(v):
            raise ValueError("doh_path must look like /dns-query")
        return v
    if key == "dns_search":
        out = []
        for tok in _tokens(v):
            name = tok[1:] if tok.startswith("~") else tok
            if name != "." and not _HOST_RE.match(name):
                raise ValueError(f"dns_search: '{tok}' is not a domain")
            out.append(tok)
        return " ".join(dict.fromkeys(out))
    if key == "trusted_node" and len(v) > 64:
        raise ValueError("trusted_node: name too long")
    return v


def clean_node(node):
    """A trusted-node entry, validated field by field.

    `dns` is the one that matters most: it becomes the resolver address in the
    ruleset, and it used to be stored exactly as typed. A value with a newline
    in it was a way to write arbitrary nft statements as root — and, through
    `include` and nft's habit of echoing the offending line, to read root-only
    files via the journal — from any `wheel` process, without a password."""
    out = {k: str(node.get(k, "")).strip() for k in ("name", "ip", "mac", "dns")}
    if not out["name"] or len(out["name"]) > 64 or _has_ctl(out["name"]):
        raise ValueError("node name required (up to 64 printable characters)")
    if not is_literal_ip(out["ip"]):
        raise ValueError(f"not an IP address: {out['ip'] or '(empty)'}")
    out["ip"] = str(ipaddress.ip_address(out["ip"]))
    out["mac"] = out["mac"].lower().replace("-", ":")
    if out["mac"] and not _MAC_RE.match(out["mac"]):
        raise ValueError(f"not a MAC address: {out['mac']}")
    if out["dns"] and not is_literal_ip(out["dns"]):
        raise ValueError(f"not an IP address: {out['dns']}")
    return out


