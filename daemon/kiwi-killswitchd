class Resolver:
    """Turn endpoint hostnames into literal IPs — over DoH, and remember answers.

    Two problems this solves at once:

    1. nft resolves hostnames itself at ruleset-load time, but it does so on the
       host, which once we are armed fail-closed has no DNS. The load then fails,
       and because `nft -f` is one transaction the ENTIRE ruleset rolls back — a
       VPN configured with a hostname remote could take the whole kill switch
       down at exactly the wrong moment. So we never put a hostname in a ruleset.

    2. `getaddrinfo` goes through the system resolver, which while armed is
       either blocked or pointed somewhere we do not trust. So we query a
       configured DoH server ourselves, over tcp/443 to a LITERAL IP that the
       ruleset explicitly permits. No bootstrap loop, nothing to resolve first.

    What this does NOT solve: the VPN client resolves its own endpoint through
    the system resolver too, and that stays blocked while no tunnel is up. This
    class only makes sure the address is PERMITTED once the client has it — see
    "Known limits" in docs/TODO.md.

    Round-robin DNS is handled by pinning ALL returned addresses — otherwise the
    address we allowed and the one the VPN client dials can differ. Every answer
    is cached (persisted), so a boot-time restore still has addresses before the
    network is usable.
    """

    TIMEOUT = 4

    def __init__(self, cfg):
        self.cfg = cfg
        self._asked = {}            # hostname -> monotonic time of the last lookup

    # ---- DNS wire format (stdlib only; no dnspython on the base image) ----
    @staticmethod
    def _encode(name, qtype):
        q = b"".join(bytes([len(p)]) + p.encode("idna")
                     for p in name.rstrip(".").split("."))
        # id 0, as RFC 8484 asks for with GET, so the URL is cache-friendly
        return (struct.pack(">HHHHHH", 0, 0x0100, 1, 0, 0, 0)
                + q + b"\x00" + struct.pack(">HH", qtype, 1))

    @staticmethod
    def _skip_name(buf, off):
        while True:
            if off >= len(buf):
                raise ValueError("truncated name")
            ln = buf[off]
            if ln == 0:
                return off + 1
            if ln & 0xC0 == 0xC0:       # compression pointer ends the name
                return off + 2
            off += 1 + ln

    @classmethod
    def _decode(cls, buf):
        if len(buf) < 12:
            raise ValueError("short response")
        _, _, qd, an, _, _ = struct.unpack(">HHHHHH", buf[:12])
        off = 12
        for _ in range(qd):
            off = cls._skip_name(buf, off) + 4
        out = []
        for _ in range(an):
            off = cls._skip_name(buf, off)
            rtype, _cls, _ttl, rdlen = struct.unpack(">HHIH", buf[off:off + 10])
            off += 10
            rdata = buf[off:off + rdlen]
            off += rdlen
            if rtype == 1 and rdlen == 4:
                out.append(socket.inet_ntop(socket.AF_INET, rdata))
            elif rtype == 28 and rdlen == 16:
                out.append(socket.inet_ntop(socket.AF_INET6, rdata))
            # CNAMEs are followed by the DoH server; we only want the addresses
        return out

    def servers(self):
        """[(ip, name the certificate is checked against)] from `doh_servers`.

        An entry is an IP literal, optionally followed by #hostname in the style
        of resolved.conf ("203.0.113.5#doh.example") for a server whose
        certificate does not list its own address."""
        out = []
        for tok in (self.cfg["doh_servers"] or "").split():
            ip, _, name = tok.partition("#")
            if is_literal_ip(ip) and (not name or _HOST_RE.match(name)):
                out.append((ip, name))
        return out

    def doh_ips(self):
        return list(dict.fromkeys(ip for ip, _ in self.servers()))

    def _doh_query(self, server, verify_as, name, qtype):
        wire = self._encode(name, qtype)
        # The certificate IS verified, against the address we dialled. The big
        # public resolvers (1.1.1.1, 9.9.9.9, 8.8.8.8) all carry their IPs as
        # subjectAltName entries, so no name has to be resolved first — the
        # chicken-and-egg that an earlier revision used as a reason to switch
        # verification off does not exist. It matters: an unverified answer
        # lets whoever runs the local network decide which addresses this
        # ruleset whitelists. A server without an IP SAN is configured as
        # ip#hostname and checked against that name instead.
        ctx = ssl.create_default_context()
        raw = socket.create_connection((server, 443), timeout=self.TIMEOUT)
        try:
            tls = ctx.wrap_socket(raw, server_hostname=verify_as or server)
        except Exception:
            raw.close()
            raise
        # http.client only dials when it has no socket yet; handing it ours is
        # how we connect to one thing (the IP) and verify another (the name)
        conn = http.client.HTTPConnection(server, 443, timeout=self.TIMEOUT)
        conn.sock = tls
        try:
            path = self.cfg["doh_path"] or "/dns-query"
            if not _PATH_RE.match(path):
                path = "/dns-query"
            # GET with base64url is the widest-supported DoH form and needs no
            # HTTP/2 (http.client is HTTP/1.1 only)
            q = base64.urlsafe_b64encode(wire).rstrip(b"=").decode()
            host = verify_as or (f"[{server}]" if is_ipv6(server) else server)
            conn.request("GET", f"{path}?dns={q}",
                         headers={"Accept": "application/dns-message",
                                  "Host": host})
            resp = conn.getresponse()
            if resp.status != 200:
                raise ValueError(f"http {resp.status}")
            return self._decode(resp.read(65535))
        finally:
            conn.close()

    def resolve(self, ep):
        if is_literal_ip(ep):
            return [ep]
        cache = self.cfg["endpoint_cache"]
        known = [i for i in cache.get(ep, []) if is_literal_ip(i)]
        # apply() runs on every network event, and each lookup is up to
        # TIMEOUT seconds per server per record type ON THE MAIN LOOP. With an
        # answer in hand there is no reason to ask again that often.
        now = time.monotonic()
        last = self._asked.get(ep)
        if known and last is not None and now - last < RESOLVE_TTL:
            return known
        self._asked[ep] = now
        ips = []
        for server, verify_as in self.servers():
            for qtype in (1, 28):
                try:
                    ips += self._doh_query(server, verify_as, ep, qtype)
                except Exception as e:  # noqa: BLE001 — any failure is just "try next"
                    log(f"doh {server} {ep} type{qtype}: {e}")
            if ips:
                break
        if not ips and not nft_present():
            # Not armed yet? then the system resolver still works and is a fine
            # fallback. With our table loaded it is blocked or steered, and
            # asking would only stall the main loop until resolved gives up.
            try:
                ips = [i[4][0] for i in socket.getaddrinfo(ep, None)]
            except Exception:  # noqa: BLE001 — a malformed name raises UnicodeError, not OSError
                ips = []
        ips = sorted({i for i in ips if is_literal_ip(i)})
        if ips:
            if cache.get(ep) != ips:
                cache[ep] = ips
                self.cfg.save()
            return ips
        if known:
            log(f"cannot resolve {ep} — using {len(known)} cached address(es)")
        else:
            log(f"cannot resolve endpoint {ep!r} and nothing is cached")
        return known


