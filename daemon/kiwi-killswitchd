class Eval:
    """What the world actually looks like, resolved against the settings."""

    def __init__(self):
        self.exit_iface = ""        # the ONE interface general traffic may use
        self.exit_is_tunnel = True  # False when a trusted node's uplink is the exit
        self.endpoints = []         # (ip, proto, port) of the selected VPN's server(s)
        self.hostnames = False      # ...at least one of which is configured by NAME
        self.conflicts = []         # other active VPNs — they fight our routing
        self.node = None            # matched trusted kiwi-node, if any
        self.complete = False       # is there a permitted path at all?
        self.stale_conn = ""        # NM says connected, but the tunnel is dead
        self.node_not_preferred = False  # node found, but not on the kernel's path
        self.resolver = ""          # chosen DNS server
        self.dns_link = ""          # the link it is set on
        self.dns_path = "blocked"   # tunnel | system | custom | blocked


class Situation:
    """Resolve the configured settings against what is actually on the machine.

    Exactly one VPN is protected at a time. Several simultaneous tunnels fight
    over the routing table and over policy-routing priorities, so we permit
    precisely one and let the rest fail to connect — they cannot reach their
    servers. We never bring a connection down: that races NetworkManager's
    autoconnect forever, and it takes a decision away from the user.
    """

    def __init__(self, cfg, resolver):
        self.cfg = cfg
        self.p = cfg.settings()
        self.resolver = resolver

    def _match_node(self, wanted):
        """Find a trusted kiwi-node on ANY uplink we currently have.

        A trusted kiwi-node uplink already tunnels for us, so the VPN can be
        skipped. Bound to IP *and* MAC: MAC binding defeats a hostile network
        handing out your router's IP. It does not defeat an on-link attacker
        forging a MAC — documented tradeoff, not a bug.

        Every default route is checked, not just the kernel's preferred one.
        With two uplinks up — coming back onto the node's LAN while a tether or
        wifi is still connected — the node's route is frequently *not* the
        lowest-metric one, and looking only at the winner meant the node was
        silently invisible: the switch fell back to demanding the VPN and kept
        using the other uplink's WAN. Which route the kernel actually prefers is
        a separate question, reported as `node_not_preferred`.

        Only real uplinks count. A node is an uplink that tunnels *for* us, so
        reaching one through a VPN we already have proves nothing — and
        neither does a default route through virtual plumbing.
        """
        preferred_dev = Net.route_dev()
        for gw, dev, _metric in Net.default_routes():
            if not gw or not Net.is_uplink(dev):
                continue
            for n in self.cfg["nodes"]:
                if n.get("ip") != gw:
                    continue
                if wanted and n.get("name") != wanted:
                    continue
                mac = str(n.get("mac") or "").lower()
                if mac and Net.gw_mac(gw, dev) != mac:
                    log(f"node {n.get('name')}: ip matches but MAC does not "
                        "— not trusted")
                    continue
                return n, dev, dev != preferred_dev
        return None, "", False

    def evaluate(self):
        ev = Eval()
        p = self.p
        ev.conflicts = [c for c in Net.active_vpns() if c and c != p["vpn"]]

        # SECURITY: a node may only stand in for the VPN when you said it may —
        # either by naming it, or by turning on auto_node. Inferring it would
        # mean that merely being on a known LAN silently disables the VPN you
        # selected.
        # auto_node means "any configured node will do", so it deliberately
        # overrides a specific pick rather than narrowing it. The two settings
        # read as contradictory otherwise: a switch labelled "accept any node"
        # that silently does nothing because one node happens to be named is
        # worse than either behaviour on its own. The UI greys the picker out
        # while this is on, so the override is visible rather than surprising.
        if truthy(p["auto_node"]):
            wanted = ""
        else:
            wanted = p["trusted_node"]
        if wanted or truthy(p["auto_node"]):
            node, node_dev, _ = self._match_node(wanted)
        else:
            node, node_dev = None, ""
        ev.node = node

        # Work out BOTH candidate paths before choosing, because a machine can
        # genuinely have both: sitting on the node's LAN with the VPN also
        # connected.
        vpn_ifc = ""
        if p["vpn"]:
            vpn_ifc, raw = Net.resolve_layer(p["vpn"])
            eps = []
            for host, proto, port in raw:
                if not is_literal_ip(host):
                    ev.hostnames = True
                eps += [(ip, proto, port) for ip in self.resolver.resolve(host)]
            ev.endpoints = list(dict.fromkeys(eps))
            if not vpn_ifc and Net.conn_active(p["vpn"]):
                # NetworkManager still lists the connection as activated while
                # its tunnel is dead at the link level — GNOME's own UI shows a
                # connected VPN. Saying only "is the VPN up?" here sends people
                # looking in the wrong place; name the discrepancy instead.
                ev.stale_conn = p["vpn"]

        # Prefer whichever path the kernel is ACTUALLY using. Choosing the node
        # just because it matched would hand the exit to the LAN uplink while a
        # connected VPN quietly owns the default route — so every packet leaves
        # on an interface the ruleset does not permit, and connecting your VPN
        # makes things worse rather than better. The kernel is the authority on
        # which one is carrying traffic.
        live = Net.route_dev()
        if vpn_ifc and vpn_ifc == live:
            ev.exit_iface, ev.exit_is_tunnel, ev.complete = vpn_ifc, True, True
        elif node and node_dev and node_dev == live:
            ev.exit_iface, ev.exit_is_tunnel, ev.complete = node_dev, False, True
        elif vpn_ifc:
            ev.exit_iface, ev.exit_is_tunnel, ev.complete = vpn_ifc, True, True
            ev.node = node = None
        elif node and node_dev:
            ev.exit_iface, ev.exit_is_tunnel, ev.complete = node_dev, False, True
            ev.node_not_preferred = node_dev != live
        if ev.exit_iface and not valid_iface(ev.exit_iface):
            # it would be written into the ruleset inside quotes — see _IFACE_RE
            log(f"interface name {ev.exit_iface!r} cannot be used in a ruleset "
                "— treating it as no exit")
            ev.exit_iface, ev.exit_is_tunnel, ev.complete = "", True, False
            ev.node = node = None
        if ev.exit_is_tunnel:
            ev.node = node = None
            ev.node_not_preferred = False
        # nothing selected and no node -> complete stays False -> block, which
        # is the correct answer, not an error

        self._pick_dns(ev)
        return ev

    def _pick_dns(self, ev):
        p = self.p
        mode = p["dns_mode"]
        # a node's resolver was stored unvalidated by older versions; it is
        # about to become a ruleset token, so it is checked here regardless
        node_dns = str((ev.node or {}).get("dns") or "")
        if not is_literal_ip(node_dns):
            node_dns = ""
        if mode == "custom" and is_literal_ip(p["dns_custom"]):
            ev.resolver, ev.dns_path = p["dns_custom"], "custom"
            ev.dns_link = ev.exit_iface or Net.physical_gw()[1]
        elif mode == "system":
            # Only ever trust the network's own resolver on a network we trust.
            # An untrusted cafe router's DNS is a surveillance channel, and it
            # is the one thing a kill switch must not wave through.
            if ev.node:
                ev.resolver = node_dns
                ev.dns_link = ev.exit_iface
                ev.dns_path = "system" if ev.resolver else "blocked"
            elif ev.exit_iface and ev.exit_is_tunnel:
                # "The network's own resolver" is not available on a network we
                # do not trust, so fall back to the one the tunnel provides and
                # say so. Leaving it unsteered also works — the backstop keeps
                # lookups inside the tunnel either way — but then resolved
                # keeps trying local resolvers we are dropping, which costs a
                # timeout on every lookup for no benefit.
                cand = Net.conn_dns(p["vpn"]) if p["vpn"] else []
                if cand:
                    ev.resolver, ev.dns_link = cand[0], ev.exit_iface
                    ev.dns_path = "fallback"
                else:
                    ev.dns_path = "unmanaged"
            else:
                ev.dns_path = "blocked"
        else:                                   # tunnel (default)
            cand = Net.conn_dns(p["vpn"]) if p["vpn"] else []
            if not cand and node_dns:
                cand = [node_dns]
            if not cand and is_literal_ip(p["dns_custom"]):
                cand = [p["dns_custom"]]
            if cand and ev.exit_iface:
                ev.resolver, ev.dns_link, ev.dns_path = cand[0], ev.exit_iface, "tunnel"
            else:
                ev.dns_path = "blocked"
        return ev


