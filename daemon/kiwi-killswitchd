class KillSwitch:
    def __init__(self, cfg, on_change):
        self.cfg = cfg
        self.fw = Firewall(cfg)
        self.resolver = Resolver(cfg)
        self.dns = Dns(cfg)
        self.on_change = on_change
        # INVARIANT 5: `armed` is intent (persisted, what the user asked for);
        # `enforcing` is verified reality (our table is really loaded). They
        # differ exactly when something went wrong — which is when the UI must
        # not claim safety.
        # `state` is the same picture as one word, so three front-ends do not
        # each have to derive it from the other fields and disagree:
        #   off | protected | trusted-node | dns-only | blocking | unprotected
        # mode / vpn / hardening start out as configured, so a daemon that has
        # only just started already tells the front-ends which connection is
        # selected instead of showing nothing until the first arm.
        self.status = {"armed": False, "enforcing": False, "state": "off",
                       "mode": str(cfg["mode"]), "exit_iface": "",
                       "vpn": str(cfg["vpn"]), "dns_path": "blocked",
                       "hardening": str(cfg["hardening"]), "node": "",
                       "conflicts": "", "pending": 0, "detail": "disarmed"}
        self._lock = threading.Lock()
        self._hard_timer = 0
        self._deadman_timer = 0
        self._loaded = None         # the exact ruleset text the kernel has

    @property
    def mgmt_routes(self):
        """Persisted for the same reason as Dns.touched — a route we pinned and
        then forgot about survives every restart and never gets removed."""
        return self.cfg["runtime"]["mgmt_routes"]

    def cleanup_orphans(self):
        """Undo anything a previous life of this process left behind.

        Called at startup while disarmed. Reverting a link we no longer own and
        deleting a route that is already gone are both harmless no-ops, so this
        is safe to run unconditionally."""
        if self.mgmt_routes or self.dns.touched:
            log(f"startup: cleaning up {len(self.mgmt_routes)} route(s) and "
                f"{len(self.dns.touched)} resolver override(s) from a previous run")
            self._del_mgmt_routes()
            self.dns.clear()

    # ---- mgmt bypass routing (survives a full tunnel) ----
    @staticmethod
    def _rule_present(sn):
        fam = ["-6"] if is_ipv6(sn) else ["-4"]
        want = ipaddress.ip_network(sn)
        for ln in run(["ip"] + fam + ["rule", "show"]).stdout.splitlines():
            pref, _, rest = ln.partition(":")
            f = rest.split()
            if pref.strip() != str(MGMT_RULE_PRIO) or "to" not in f[:-1]:
                continue
            if "lookup" not in f[:-1] or f[f.index("lookup") + 1] != "main":
                continue
            try:
                if ipaddress.ip_network(f[f.index("to") + 1], strict=False) == want:
                    return True
            except ValueError:
                continue
        return False

    @staticmethod
    def _pin_present(rec):
        for ln in run(["ip", "route", "show", "exact", rec["subnet"]]).stdout.splitlines():
            f = ln.split()
            if (f"via {rec['gw']} " in ln + " " and f"dev {rec['dev']} " in ln + " "
                    and "metric" in f[:-1]
                    and f[f.index("metric") + 1] == str(MGMT_METRIC)):
                return True
        return False

    def _sync_mgmt(self, p):
        """Keep admin subnets off the tunnel — and CHECK, every time, that they
        still are.

        Every management subnet gets a policy rule ahead of the VPN's. A pinned
        route as well only when the subnet would otherwise follow a tunnel's
        routes in `main` AND is not attached: forcing an on-link subnet through
        the gateway breaks return traffic and cuts the very SSH session this is
        supposed to protect, and a bridge's own subnet (libvirt, podman) must
        never be sent out the physical NIC.

        The record says what we OWN, so it can be undone exactly. The kernel
        says what EXISTS. An earlier revision asked the record both questions,
        so a rule that had vanished was never put back — and a reboot while
        armed is enough for that, policy rules do not persist: the machine came
        up, the VPN took the default route, and the admin LAN went into the
        tunnel with it.

        A held pin is not re-judged against "is it tunnel-routed": once pinned
        it no longer is, and asking would undo the pin immediately.
        """
        want = subnets_of(p["mgmt_subnets"])
        for rec in list(self.mgmt_routes):
            if not isinstance(rec, dict) or rec.get("subnet") not in want:
                self._del_one_mgmt_route(rec)
        gw, dev = Net.physical_gw()
        changed = False
        for sn in want:
            rec = next((r for r in self.mgmt_routes if r.get("subnet") == sn), None)
            fresh = rec is None
            if fresh:
                rec = {"subnet": sn, "rule": False, "gw": "", "dev": ""}
            was = dict(rec)
            fam = ["-6"] if is_ipv6(sn) else ["-4"]

            if self._rule_present(sn):
                rec["rule"] = True          # ours by its signature; ours to remove
            elif run(["ip"] + fam + ["rule", "add", "to", sn, "lookup", "main",
                                     "priority", str(MGMT_RULE_PRIO)]).returncode == 0:
                if rec["rule"]:
                    log(f"mgmt {sn}: the policy rule had vanished — restored")
                rec["rule"] = True

            onlink = Net.is_onlink(sn)
            if rec["gw"] and (onlink or (rec["gw"], rec["dev"]) != (gw, dev)):
                # the uplink moved, or we are now ON that network
                run(["ip", "route", "del", sn, "via", rec["gw"], "dev", rec["dev"],
                     "metric", str(MGMT_METRIC)])
                rec["gw"], rec["dev"] = "", ""
            wanted_pin = bool(rec["gw"]) or (not onlink and bool(gw and dev)
                                             and Net.routed_via_tunnel(sn))
            if wanted_pin and not (rec["gw"] and self._pin_present(rec)):
                if run(["ip", "route", "replace", sn, "via", gw, "dev", dev,
                        "metric", str(MGMT_METRIC)]).returncode == 0:
                    rec["gw"], rec["dev"] = gw, dev
                else:
                    rec["gw"], rec["dev"] = "", ""

            if fresh and (rec["rule"] or rec["gw"]):
                self.mgmt_routes.append(rec)
                log(f"mgmt {sn}: kept on the local uplink"
                    + (f", pinned via {gw} dev {dev}" if rec["gw"] else ""))
            changed = changed or rec != was
        if changed:
            self.cfg.save()

    def _del_one_mgmt_route(self, rec):
        """Delete only the exact route we installed.

        `ip route del <prefix>` with nothing else deletes WHATEVER route matches
        that prefix. When our pin is already gone — NetworkManager reapplied the
        connection, the link bounced, the machine rebooted — that is the
        kernel's own on-link route for the admin LAN, and removing it cuts every
        session on that network instantly. This happened: restarting the daemon
        ran the startup cleanup, which deleted `192.168.0.0/16`, and the test
        machine dropped off the LAN mid-install.

        So we record what we added and delete that exact route, metric included.
        A record from an older version is a bare string with no gateway, and
        there is no safe way to delete it — drop the record and leave the route
        alone. A stale pin is untidy; cutting the admin LAN is not.
        """
        if isinstance(rec, dict) and norm_subnet(str(rec.get("subnet", ""))):
            sn = rec["subnet"]
            fam = ["-6"] if is_ipv6(sn) else ["-4"]
            if rec.get("gw") and rec.get("dev"):
                run(["ip", "route", "del", sn, "via", rec["gw"],
                     "dev", rec["dev"], "metric", str(MGMT_METRIC)])
            if rec.get("rule"):
                # a rule can be stacked by a crash between add and save
                for _ in range(4):
                    if run(["ip"] + fam + ["rule", "del", "to", sn, "lookup", "main",
                                           "priority", str(MGMT_RULE_PRIO)]).returncode != 0:
                        break
        else:
            log(f"mgmt route record {rec!r} predates exact deletion — "
                "dropping the record without touching the routing table")
        if rec in self.mgmt_routes:
            self.mgmt_routes.remove(rec)
        self.cfg.save()

    def _del_mgmt_routes(self):
        for rec in list(self.mgmt_routes):
            self._del_one_mgmt_route(rec)
        del self.mgmt_routes[:]
        self.cfg.save()

    # ---- hardening watchdog ----
    def _cancel_watchdog(self):
        if self._hard_timer:
            GLib.source_remove(self._hard_timer)
            self._hard_timer = 0

    def _arm_watchdog(self, p):
        """`paranoid` adds a netdev egress chain with a drop policy. Get one
        allow-rule wrong and the machine is fully offline with no obvious way
        back, so the first apply is provisional: confirm it within
        hardening_confirm_sec or it reverts itself to `strict`."""
        if p["hardening"] != "paranoid" or truthy(p["hardening_confirmed"]):
            self._cancel_watchdog()
            return
        # The deadline is set ONCE, when the provisional state begins. Re-arming
        # it on every apply looks equivalent and is not: apply() runs on every
        # link event, NM event and reconcile tick, so on any live machine the
        # timer was cancelled and restarted before it could ever fire — the
        # safety net silently never triggered. Observed on the test box: two
        # "provisional" lines 12s apart and no expiry. Leave a running deadline
        # alone.
        if self._hard_timer:
            return
        secs = max(15, int_of(self.cfg["hardening_confirm_sec"], 90))
        log(f"paranoid hardening is provisional — confirm within {secs}s")
        self._hard_timer = GLib.timeout_add_seconds(secs, self._watchdog_expired)

    def _watchdog_expired(self):
        self._hard_timer = 0
        log("paranoid hardening was not confirmed — falling back to strict")
        self.cfg["hardening"] = "strict"
        self.cfg.save()
        self.sync()
        return False

    # ---- deadman switch (opt-in, and genuinely dangerous) ----
    def _cancel_deadman(self):
        if self._deadman_timer:
            GLib.source_remove(self._deadman_timer)
            self._deadman_timer = 0

    def _arm_deadman(self):
        """Disarm by ourselves if nobody confirms in time.

        This exists for working on a machine you can only reach over the
        network: get a rule wrong, lose the session, and the box comes back on
        its own instead of needing someone at the console.

        It is also the one feature here that deliberately turns protection OFF
        without being asked, which is the exact opposite of what a kill switch
        promises. So it is off by default, it lives behind developer mode, and
        the UI says plainly what it does.
        """
        self._cancel_deadman()
        secs = int_of(self.cfg["deadman_sec"], 0)
        if secs <= 0 or not truthy(self.cfg["developer_mode"]):
            return
        secs = max(30, secs)
        log(f"deadman: will DISARM in {secs}s unless confirmed")
        self._deadman_timer = GLib.timeout_add_seconds(secs, self._deadman_expired)

    def _deadman_expired(self):
        self._deadman_timer = 0
        log("deadman: nobody confirmed — DISARMING, this machine is now unprotected")
        self.disarm()
        return False

    def confirm(self):
        """"I am still here" — keeps provisional hardening, stops the deadman."""
        self._cancel_watchdog()
        self._cancel_deadman()
        self.cfg["hardening_confirmed"] = True
        self.cfg.save()
        log("confirmed: hardening kept, deadman cancelled")
        self._notify()

    # ---- apply ----
    def _load(self, text):
        """Install a ruleset — unless that exact text is what is already loaded.

        Reloading an identical ruleset is not free: it resets every counter,
        the ks-drop-* ones included, and those are the evidence of what was
        blocked. Skipped only when the kernel confirms our tables are there."""
        if text == self._loaded and nft_present(netdev=f"table netdev {NETDEV_TABLE} {{" in text):
            return True
        ok = nft_apply(text)
        self._loaded = text if ok else None
        return ok

    def _load_fallback(self, p=None):
        """Something went wrong: block. True if SOME block got loaded."""
        try:
            if self._load(self.fw.hard_block(p if p is not None
                                             else self.cfg.settings())):
                return True
        except Exception as e:  # noqa: BLE001 — the rung below needs no input at all
            log(f"hard block could not be built: {e}")
        log("hard block rejected too — loading the bare lockdown")
        return self._load(self.fw.lockdown())

    def _fail_closed(self):
        """apply() blew up before it could say anything. Block, and say so."""
        try:
            self._load_fallback()
        except Exception as e:  # noqa: BLE001
            log(f"fallback failed: {e}")
        enforcing = nft_present()
        if not enforcing:
            log("CRITICAL: no ruleset is loaded — traffic is NOT being filtered")
        self.status.update(
            armed=True, enforcing=enforcing, exit_iface="", node="",
            dns_path="blocked", conflicts="", vpn=str(self.cfg["vpn"]),
            state="blocking" if enforcing else "unprotected",
            detail=("blocking (internal error — check the journal)" if enforcing
                    else "NOT PROTECTED — firewall failed, check the journal"))

    @staticmethod
    def _aux(what, fn, *args):
        """Run a step that must not be able to take the firewall down with it.

        DNS steering and management routing sit on top of a ruleset that is
        already loaded. If one of them raises, that is a degraded state — not
        a reason to throw away a good ruleset for a hard block."""
        try:
            fn(*args)
        except Exception as e:  # noqa: BLE001
            log(f"{what} step failed — {type(e).__name__}: {e}")

    def apply(self):
        """Look at the world and enforce it. NEVER raises.

        Anything that goes wrong before a ruleset is loaded ends in a block and
        a status that says so. This used to be able to raise — one malformed
        hostname in a connection was enough — and then `armed` was already
        saved, no table had been loaded, the status still read "disarmed", and
        the next start crashed on the same input: fail-open, and silent."""
        try:
            sit = Situation(self.cfg, self.resolver)
            ev = sit.evaluate()
            if sit.p["mode"] == "node":
                self._apply_node(sit.p, ev)
            else:
                self._apply_full(sit.p, ev)
        except Exception as e:  # noqa: BLE001
            log(f"apply failed — {type(e).__name__}: {e}")
            self._fail_closed()

    def _apply_full(self, p, ev):
        doh = self.resolver.doh_ips()
        ok = self._load(self.fw.full(ev, p, doh))
        if not ok:
            # The transaction rolled back — whatever was loaded before is still
            # loaded, and if that was nothing we are wide open. Blocking is the
            # only safe answer here.
            log("ruleset rejected — falling back to a hard block")
            ev.complete = False
            ev.exit_iface = ""
            ev.resolver = ev.dns_link = ""
            ev.dns_path = "blocked"
            self._load_fallback(p)
        enforcing = nft_present()
        if not enforcing:
            log("CRITICAL: no ruleset is loaded — traffic is NOT being filtered")

        self._aux("dns", self.dns.apply, ev, p)
        self._aux("mgmt", self._sync_mgmt, p)
        self._aux("watchdog", self._arm_watchdog, p)

        if not enforcing:
            state = "unprotected"
            detail = "NOT PROTECTED — firewall failed, check the journal"
        elif not ok:
            state = "blocking"
            detail = "blocking (firewall error — check the journal)"
        elif self.cfg.unreadable:
            state = "blocking"
            detail = ("blocking — the saved configuration could not be read, "
                      "so nothing is permitted. Disarm to start from defaults.")
        elif ev.stale_conn:
            state = "blocking"
            detail = (f"blocking — NetworkManager still shows '{ev.stale_conn}' "
                      "as connected, but its tunnel interface is down")
        elif not ev.complete:
            state = "blocking"
            detail = "blocking (no permitted path — is the VPN up?)"
        elif not ev.exit_is_tunnel:
            state = "trusted-node"
            detail = f"trusted node {ev.node.get('name', '')}"
            if ev.node_not_preferred:
                state = "blocking"
                detail += (" — but the system is routing through another uplink, "
                           "so traffic is blocked. Disconnect that uplink, or "
                           f"give {ev.exit_iface} priority in GNOME Settings.")
        else:
            state = "protected"
            detail = f"protected via {ev.exit_iface}"
        if ev.conflicts and ev.complete:
            detail += f" — conflicting tunnel: {', '.join(ev.conflicts)}"

        self.status.update(armed=True, enforcing=enforcing, state=state,
                           mode="full", exit_iface=ev.exit_iface, vpn=p["vpn"],
                           dns_path=ev.dns_path, hardening=p["hardening"],
                           node=(ev.node or {}).get("name", ""),
                           conflicts=" ".join(ev.conflicts), detail=detail)
        line = (f"applied full: vpn={p['vpn'] or '(none)'} "
                f"exit={ev.exit_iface or 'blocked'} dns={ev.dns_path} "
                f"hardening={p['hardening']} enforcing={enforcing}")
        self._log_change(line)

    def _apply_node(self, p, ev):
        ok = self._load(self.fw.node(ev, p))
        if not ok:
            log("node ruleset rejected — falling back to a hard block")
            ev.resolver = ev.dns_link = ""
            ev.dns_path = "blocked"
            self._load_fallback(p)
        enforcing = nft_present()
        self._aux("dns", self.dns.apply, ev, p)
        self._cancel_watchdog()
        addr = self.fw.node_dns(ev)
        if not enforcing:
            state, detail = "unprotected", "NOT PROTECTED — firewall failed, check the journal"
        elif not ok:
            state, detail = "blocking", "blocking (firewall error — check the journal)"
        elif addr:
            state = "dns-only"
            detail = f"DNS only: lookups forced to {addr}, internet open"
        else:
            # say it: with no node to send them to, the drop rules stand alone
            state = "dns-only"
            detail = ("DNS only: no trusted node on this network, so lookups "
                      "are blocked — internet open")
        self.status.update(armed=True, enforcing=enforcing, state=state,
                           mode="node", exit_iface="", vpn=p["vpn"],
                           dns_path=ev.dns_path, hardening=p["hardening"],
                           node=(ev.node or {}).get("name", ""),
                           conflicts=" ".join(ev.conflicts), detail=detail)
        self._log_change(f"applied node: dns={ev.dns_path} enforcing={enforcing}")

    def _log_change(self, line):
        """One journal line per CHANGE of outcome, not one per apply — apply
        runs on every network event and a periodic safety pass."""
        if line != getattr(self, "_last_line", None):
            self._last_line = line
            log(line)

    # ---- public ops ----
    def arm(self, vpn=None):
        if vpn:
            # picking a connection from the Quick Settings menu both selects
            # and enforces it — a complete action, not a staged one, and it
            # supersedes a pick that was staged and never applied
            self.cfg["vpn"] = vpn
            self.cfg["pending"].pop("vpn", None)
        self.cfg["armed"] = True
        self.cfg.save()
        with self._lock:
            self.apply()
        self._arm_deadman()
        self._notify()

    def disarm(self):
        self._cancel_watchdog()
        self._cancel_deadman()
        nft_drop_tables()
        self._loaded = None
        self._last_line = None
        self.cfg["armed"] = False
        self.cfg.unreadable = False
        self.cfg.save()
        self._aux("dns", self.dns.clear)
        self._aux("mgmt", self._del_mgmt_routes)
        # clear the whole picture, not just `armed` — leaving the last-applied
        # mode/hardening/vpn behind makes a disarmed daemon look like it is
        # still enforcing something
        self.status.update(armed=False, enforcing=False, state="off",
                           exit_iface="", dns_path="system", node="",
                           conflicts="", mode=self.cfg["mode"],
                           vpn=self.cfg["vpn"],
                           hardening=self.cfg["hardening"], detail="disarmed")
        self._notify()

    def sync(self):
        """Re-evaluate. Tells the front-ends only if the answer changed — they
        each re-read everything on a signal, and most syncs change nothing."""
        if self.cfg["armed"]:
            before = dict(self.status)
            with self._lock:
                self.apply()
            if self.status != before:
                self._notify()

    def restore(self):
        if self.cfg["armed"]:
            with self._lock:
                self.apply()
            log("restored armed state at startup")

    def _notify(self):
        self.status["pending"] = len(self.cfg["pending"])
        if self.on_change:
            GLib.idle_add(self.on_change)   # may be called from a worker thread


