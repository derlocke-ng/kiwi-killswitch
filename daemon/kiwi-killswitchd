class Debounced:
    """Collapse a burst of events into one call, ~1.2s after the last one —
    but no later than DEBOUNCE_MAX_MS after the first, so a link that flaps
    without pause cannot postpone the sync for ever.

    One instance is shared by both watchers: a VPN coming up makes
    NetworkManager and the kernel report within the same second, and two
    timers meant two full applies for one event."""

    def __init__(self, on_event):
        self.on_event = on_event
        self._pending = 0
        self._first = 0.0

    def poke(self, *_):
        now = time.monotonic()
        if self._pending:
            if (now - self._first) * 1000 >= DEBOUNCE_MAX_MS:
                return                    # let the running timer fire
            GLib.source_remove(self._pending)
        else:
            self._first = now
        self._pending = GLib.timeout_add(DEBOUNCE_MS, self._fire)

    def _fire(self):
        self._pending = 0
        try:
            self.on_event()
        except Exception as e:  # noqa: BLE001
            log(f"event handler error: {e}")
        return False


class NMMonitor:
    """React to NetworkManager state changes in real time (debounced)."""

    def __init__(self, bus, poke):
        for sig in ("StateChanged", "DeviceAdded", "DeviceRemoved"):
            bus.signal_subscribe("org.freedesktop.NetworkManager", None, sig,
                                 None, None, Gio.DBusSignalFlags.NONE,
                                 lambda *_: poke())


class LinkMonitor:
    """React to kernel link/address/route changes.

    INVARIANT 3. NetworkManager events are NOT enough: a tunnel that dies at the
    link level — the normal way OpenVPN and WireGuard fail — emits no NM signal
    at all, because NM still considers the connection active. Without this the
    daemon never re-syncs, the ruleset keeps pointing at a dead interface,
    everything stays blocked, and the user's only way back online is to re-arm by
    hand — or to disarm, which is precisely when the real IP is exposed. That is
    the "I have to re-trigger it" bug. Watching the kernel directly closes it.

    It also drives the netdev rebuild when a NIC appears (wifi, USB tethering).

    Do not remove this again.
    """

    def __init__(self, poke):
        self.poke = poke
        self._proc = None
        self._queued = False
        self._start()

    def _start(self):
        try:
            self._proc = subprocess.Popen(
                ["ip", "-o", "monitor", "link", "addr", "route"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError as e:
            log(f"ip monitor unavailable ({e}) — reconcile loop only")
            return False
        # A plain reader thread: all we need from the pipe is "something
        # happened", and this keeps us off the GLib/Gio fd wrappers PyGObject
        # keeps deprecating — a daemon that fails to start on the next
        # PyGObject is a machine stuck on the boot-time hard block.
        threading.Thread(target=self._reader, args=(self._proc,),
                         daemon=True).start()
        return False

    def _reader(self, proc):
        for _line in proc.stdout:
            if not self._queued:              # one wake-up per burst is enough
                self._queued = True
                GLib.idle_add(self._deliver)
        proc.wait()
        GLib.idle_add(self._died)

    def _deliver(self):
        self._queued = False
        self.poke()
        return False

    def _died(self):                          # monitor died — never go deaf
        log("ip monitor ended — restarting in 2s")
        GLib.timeout_add_seconds(2, self._start)
        return False


