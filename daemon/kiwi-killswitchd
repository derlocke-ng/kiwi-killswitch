class Debounced:
    """Collapse a burst of events into one call, ~1.2s after the last one."""

    def __init__(self, on_event):
        self.on_event = on_event
        self._pending = 0

    def _changed(self, *_):
        if self._pending:
            GLib.source_remove(self._pending)
        self._pending = GLib.timeout_add(DEBOUNCE_MS, self._fire)

    def _fire(self):
        self._pending = 0
        try:
            self.on_event()
        except Exception as e:  # noqa: BLE001
            log(f"event handler error: {e}")
        return False


class NMMonitor(Debounced):
    """React to NetworkManager state changes in real time (debounced)."""

    def __init__(self, bus, on_event):
        super().__init__(on_event)
        for sig in ("StateChanged", "DeviceAdded", "DeviceRemoved"):
            bus.signal_subscribe("org.freedesktop.NetworkManager", None, sig,
                                 None, None, Gio.DBusSignalFlags.NONE, self._changed)


class LinkMonitor(Debounced):
    """React to kernel link/address/route changes.

    INVARIANT 3. NetworkManager events are NOT enough: a tunnel that dies at the
    link level — the normal way OpenVPN and WireGuard fail — emits no NM signal
    at all, because NM still considers the connection active. Without this the
    daemon never re-syncs, the ruleset keeps pointing at a dead interface,
    everything stays blocked, and the user's only way back online is to re-arm by
    hand — or to disarm, which is precisely when the real IP is exposed. That is
    the "I have to re-trigger it" bug. Watching the kernel directly closes it.

    It also drives the netdev rebuild when a NIC appears (wifi, USB tethering).

    Do not remove this again.
    """

    def __init__(self, on_event):
        super().__init__(on_event)
        self._proc = None
        self._start()

    def _start(self):
        try:
            self._proc = subprocess.Popen(
                ["ip", "-o", "monitor", "link", "addr", "route"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError as e:
            log(f"ip monitor unavailable ({e}) — reconcile loop only")
            return False
        stream = Gio.DataInputStream.new(
            Gio.UnixInputStream.new(self._proc.stdout.fileno(), False))
        self._read(stream)
        return False

    def _read(self, stream):
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_line)

    def _on_line(self, stream, res):
        try:
            line, _ = stream.read_line_finish(res)
        except GLib.Error as e:
            log(f"ip monitor read error: {e}")
            line = None
        if line is None:                      # monitor died — never go deaf
            log("ip monitor ended — restarting in 2s")
            GLib.timeout_add_seconds(2, self._start)
            return
        self._changed()
        self._read(stream)


