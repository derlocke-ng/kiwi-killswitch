# ---------------------------------------------------------------------------
def run(cmd, **kw):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, **kw)
    except OSError as e:
        log(f"cannot run {cmd[0]}: {e}")
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def log(msg):
    print(f"kiwi-killswitchd: {msg}", file=sys.stderr, flush=True)


def nft_apply(ruleset, path=RUNTIME_RULESET):
    with open(path, "w") as fh:
        fh.write(ruleset)
    r = run(["nft", "-f", path])
    if r.returncode != 0:
        log(f"nft error: {r.stderr.strip()}")
    return r.returncode == 0


def nft_drop_tables():
    for fam, tbl in (("inet", TABLE), ("netdev", NETDEV_TABLE)):
        run(["nft", "delete", "table", fam, tbl])


def nft_present():
    """Ground truth: is our main table actually loaded in the kernel?

    INVARIANT 4: `nft -f` is ONE transaction — a single bad line rolls the whole
    file back. If we were disarmed at the time that leaves no table at all, i.e.
    no firewall, while the UI happily reports 'armed'. Never trust the return
    code alone; ask the kernel."""
    return run(["nft", "list", "table", "inet", TABLE]).returncode == 0


def is_ipv6(a):
    return ":" in a


def is_literal_ip(a):
    try:
        ipaddress.ip_address(a)
        return True
    except ValueError:
        return False


# an endpoint must look like an IP or hostname (a dot or colon, only safe chars)
# — anything else is parser garbage and must NEVER reach nft
_EP_RE = re.compile(r"^[A-Za-z0-9._:\-]+$")


def valid_endpoint(ep):
    return bool(ep) and bool(_EP_RE.match(ep)) and ("." in ep or ":" in ep)


def valid_subnet(s):
    try:
        ipaddress.ip_network(s, strict=False)
        return True
    except ValueError:
        return False


def nft_ident(name):
    """nft chain identifiers are not arbitrary strings — a vlan like 'eth0.10'
    or a bridge like 'br-lan' would not parse."""
    return re.sub(r"[^A-Za-z0-9_]", "_", name)


def truthy(v):
    return v in (True, 1, "1", "true", "True", "yes", "on")


# ---------------------------------------------------------------------------
class Resolver:
    """Turn endpoint hostnames into literal IPs — over DoH, and remember answers.

    Two problems this solves at once:

    1. nft resolves hostnames itself at ruleset-load time, but it does so on the
       host, which once we are armed fail-closed has no DNS. The load then fails,
       and because `nft -f` is one transaction the ENTIRE ruleset rolls back — a
       VPN configured with a hostname remote could take the whole kill switch
       down at exactly the wrong moment. So we never put a hostname in a ruleset.

    2. `getaddrinfo` goes through the system resolver, which while armed is
       either blocked or pointed somewhere we do not trust. So we query a
       configured DoH server ourselves, over tcp/443 to a LITERAL IP that the
       ruleset explicitly permits. No bootstrap loop, nothing to resolve first.

    Round-robin DNS is handled by pinning ALL returned addresses — otherwise the
    address we allowed and the one the VPN client dials can differ. Every answer
    is cached (persisted), so a boot-time restore still has addresses before the
    network is usable.
    """

    TIMEOUT = 4

    def __init__(self, cfg):
        self.cfg = cfg

    # ---- DNS wire format (stdlib only; no dnspython on the base image) ----
    @staticmethod
    def _encode(name, qtype):
        q = b"".join(bytes([len(p)]) + p.encode("idna")
                     for p in name.rstrip(".").split("."))
        # id 0: DoH caches on the URL, and we use POST anyway
        return (struct.pack(">HHHHHH", 0, 0x0100, 1, 0, 0, 0)
                + q + b"\x00" + struct.pack(">HH", qtype, 1))

    @staticmethod
    def _skip_name(buf, off):
        while True:
            if off >= len(buf):
                raise ValueError("truncated name")
            ln = buf[off]
            if ln == 0:
                return off + 1
            if ln & 0xC0 == 0xC0:       # compression pointer ends the name
                return off + 2
            off += 1 + ln

    @classmethod
    def _decode(cls, buf):
        if len(buf) < 12:
            raise ValueError("short response")
        _, _, qd, an, _, _ = struct.unpack(">HHHHHH", buf[:12])
        off = 12
        for _ in range(qd):
            off = cls._skip_name(buf, off) + 4
        out = []
        for _ in range(an):
            off = cls._skip_name(buf, off)
            rtype, _cls, _ttl, rdlen = struct.unpack(">HHIH", buf[off:off + 10])
            off += 10
            rdata = buf[off:off + rdlen]
            off += rdlen
            if rtype == 1 and rdlen == 4:
                out.append(socket.inet_ntop(socket.AF_INET, rdata))
            elif rtype == 28 and rdlen == 16:
                out.append(socket.inet_ntop(socket.AF_INET6, rdata))
            # CNAMEs are followed by the DoH server; we only want the addresses
        return out

    def _doh_query(self, server, name, qtype):
        wire = self._encode(name, qtype)
        # The server is an IP literal, so there is no certificate hostname to
        # check against it. Verification would need the provider's name, which we
        # cannot resolve while armed — the same chicken-and-egg this class exists
        # to break. That is acceptable here and ONLY here: a hostile answer can
        # add an allowed destination, it cannot read tunnelled traffic, and the
        # address is cross-checked against the cache before it replaces it.
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        conn = http.client.HTTPSConnection(server, 443, timeout=self.TIMEOUT,
                                           context=ctx)
        try:
            path = self.cfg["doh_path"] or "/dns-query"
            # GET with base64url is the widest-supported DoH form and needs no
            # HTTP/2 (http.client is HTTP/1.1 only)
            q = base64.urlsafe_b64encode(wire).rstrip(b"=").decode()
            conn.request("GET", f"{path}?dns={q}",
                         headers={"Accept": "application/dns-message",
                                  "Host": server})
            resp = conn.getresponse()
            if resp.status != 200:
                raise ValueError(f"http {resp.status}")
            return self._decode(resp.read(65535))
        finally:
            conn.close()

    def doh_ips(self):
        return [s for s in (self.cfg["doh_servers"] or "").split()
                if is_literal_ip(s)]

    def resolve(self, ep):
        if is_literal_ip(ep):
            return [ep]
        cache = self.cfg["endpoint_cache"]
        ips = []
        for server in self.doh_ips():
            for qtype in (1, 28):
                try:
                    ips += self._doh_query(server, ep, qtype)
                except Exception as e:  # noqa: BLE001 — any failure is just "try next"
                    log(f"doh {server} {ep} type{qtype}: {e}")
            if ips:
                break
        if not ips:
            # Not armed yet? then the system resolver still works and is a fine
            # fallback. While armed it will simply fail and we fall through.
            try:
                ips = [i[4][0] for i in socket.getaddrinfo(ep, None)]
            except OSError:
                ips = []
        ips = sorted({i for i in ips if is_literal_ip(i)})
        if ips:
            if cache.get(ep) != ips:
                cache[ep] = ips
                self.cfg.save()
            return ips
        known = cache.get(ep, [])
        if known:
            log(f"cannot resolve {ep} — using {len(known)} cached address(es)")
        else:
            log(f"cannot resolve endpoint {ep!r} and nothing is cached")
        return known


