class Config:
    def __init__(self):
        self.data = json.loads(json.dumps(DEFAULTS))   # deep copy
        # True when a config file existed but could not be read. Sticky until
        # the user disarms: it is what the status line explains itself with.
        self.unreadable = False
        self.load()

    @staticmethod
    def _read(path):
        with open(path) as fh:
            cand = json.load(fh)
        if not isinstance(cand, dict):
            raise ValueError("not a JSON object")
        return cand

    def load(self):
        """Read the config — and FAIL CLOSED if it is there but unreadable.

        A missing file is a fresh install: defaults, disarmed. A file that
        exists and does not parse is something else entirely — a torn write, a
        hand edit with a stray comma — and treating that as "defaults" meant a
        machine that was armed came back up silently unprotected. So: fall back
        to the last good copy, and if there is none, behave as armed with
        nothing permitted until the user says otherwise."""
        loaded = None
        try:
            loaded = self._read(CONFIG_JSON)
        except FileNotFoundError:
            loaded = {}
        except (OSError, ValueError) as e:
            log(f"cannot read {CONFIG_JSON}: {e}")
            try:
                loaded = self._read(CONFIG_JSON + ".bak")
                log(f"using the last good copy, {CONFIG_JSON}.bak")
            except (OSError, ValueError):
                log("CONFIG UNREADABLE and no good copy — failing closed: "
                    "this machine is treated as armed until it is disarmed")
                self.unreadable = True
        for k, v in (loaded or {}).items():
            self.data[k] = v
        if self.unreadable:
            self.data["armed"] = True
        # containers we index into must have the right shape whatever the
        # file said — a hand-edited "nodes": null must not raise mid-apply
        if not isinstance(self.data.get("nodes"), list):
            self.data["nodes"] = []
        self.data["nodes"] = [n for n in self.data["nodes"] if isinstance(n, dict)]
        for k in ("endpoint_cache", "pending"):
            if not isinstance(self.data.get(k), dict):
                self.data[k] = {}
        rt = self.data.get("runtime")
        if not isinstance(rt, dict):
            rt = self.data["runtime"] = {}
        for k in ("dns_links", "mgmt_routes"):
            if not isinstance(rt.get(k), list):
                rt[k] = []

    @staticmethod
    def _keep_backup():
        """Copy the current file aside — only while it is still good."""
        try:
            with open(CONFIG_JSON) as fh:
                text = fh.read()
            if not isinstance(json.loads(text), dict):
                return
            with open(CONFIG_JSON + ".bak.tmp", "w") as fh:
                fh.write(text)
            os.replace(CONFIG_JSON + ".bak.tmp", CONFIG_JSON + ".bak")
        except (OSError, ValueError):
            pass

    def save(self):
        """Persist atomically and durably. Never raises.

        rename() alone is atomic but not durable: without the fsync a power
        cut can leave the NEW name pointing at an empty file, which is exactly
        the unreadable-config case load() has to fail closed on. And a full
        disk must not be able to throw out of the middle of an arm — the
        firewall matters more than the file."""
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            self._keep_backup()
            tmp = CONFIG_JSON + ".tmp"
            with open(tmp, "w") as fh:
                json.dump(self.data, fh, indent=2, sort_keys=True)
                fh.flush()
                os.fsync(fh.fileno())
            os.chmod(tmp, 0o644)
            os.replace(tmp, CONFIG_JSON)
            dfd = os.open(STATE_DIR, os.O_RDONLY)
            try:
                os.fsync(dfd)
            finally:
                os.close(dfd)
            return True
        except OSError as e:
            log(f"CANNOT SAVE the configuration: {e}")
            return False

    def __getitem__(self, k):
        return self.data.get(k, DEFAULTS.get(k))

    def __setitem__(self, k, v):
        self.data[k] = v

    # ---- settings ----
    def settings(self):
        """The effective settings, as a plain dict. Never a live reference."""
        return {k: self[k] for k in SETTABLE}

    def flat(self):
        """The settings as strings, for D-Bus.

        This is what is IN EFFECT — staged changes are deliberately not merged
        in. `kiwi-killswitch config` showing a value that is not actually
        enforced yet is precisely the confusion the staging model exists to
        prevent. Callers that want the prospective view read GetPending too and
        overlay it themselves, which is what the settings app does so it can
        mark those rows."""
        return {k: self._str(self[k]) for k in SETTABLE}

    # ---- staging ----
    def set_pending(self, key, value):
        if key not in SETTABLE:
            raise ValueError(f"unknown key {key}")
        self["pending"][key] = clean_setting(key, value)
        self.save()

    def promote(self):
        """Merge staged changes into the live settings. True if anything moved."""
        pend = self["pending"]
        if not pend:
            return False
        was_hardening = self["hardening"]
        for k, v in pend.items():
            if k in SETTABLE:
                self[k] = truthy(v) if k in BOOLS else v
        if self["hardening"] not in HARDENING_LEVELS:
            self["hardening"] = "strict"
        # Escalating INTO paranoid is provisional again, even if it was
        # confirmed before: the netdev chain is built from the allow-list, so a
        # setup confirmed under a different mgmt_subnets can lock the machine
        # out today. Confirming is cheap; being locked out of a headless box
        # is not.
        if (self["hardening"] == "paranoid" and was_hardening != "paranoid"
                and "hardening_confirmed" not in pend):
            self["hardening_confirmed"] = False
        self["pending"] = {}
        self.save()
        return True

    @staticmethod
    def _str(v):
        if isinstance(v, bool):
            return "1" if v else "0"
        return str(v)


