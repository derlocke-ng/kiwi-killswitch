class Service:
    NODE_KEYS = ("name", "ip", "mac", "dns")

    def __init__(self):
        self.cfg = Config()
        self.ks = KillSwitch(self.cfg, self._emit_changed)
        self.conn = None
        self.reg_id = 0
        self._fp = ""

    # ---- lifecycle ----
    def start(self):
        self.bus = Gio.bus_get_sync(BUS_TYPE, None)
        self.node_info = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)
        # Register the object BEFORE asking for the name. The other order looks
        # natural and is racy: the bus grants the name immediately, so a client
        # that is watching for it can call us in the window before the
        # name-acquired callback has run — and gets "object does not exist at
        # path". With this order the object is always there by the time anyone
        # can find us.
        self.conn = self.bus
        self.reg_id = self.bus.register_object(
            OBJ_PATH, self.node_info.interfaces[0], self._handle, None, None)
        Gio.bus_own_name_on_connection(self.bus, BUS_NAME,
                                       Gio.BusNameOwnerFlags.NONE,
                                       self._on_acquired, None)
        self.monitor = NMMonitor(self.bus, self._on_event)
        # the kernel is the authority on whether a tunnel is actually alive
        self.links = LinkMonitor(self._on_event)
        GLib.timeout_add_seconds(RECONCILE_SEC, self._reconcile)
        if not self.cfg["armed"]:
            self.ks.cleanup_orphans()
        self.ks.restore()

    def _on_acquired(self, _conn, name):
        log(f"owning {name} on the system bus")

    def _on_event(self):
        self._fp = Net.fingerprint()          # we are acting on this state now
        if self.cfg["armed"]:
            self.ks.sync()

    def _reconcile(self):
        """Belt and braces: re-assert a vanished ruleset, and catch network
        drift both watchers missed. Compares a cheap snapshot instead of
        re-applying blindly, so an idle armed machine costs one `ip` call every
        RECONCILE_SEC and no nft churn at all."""
        try:
            # INVARIANT 7. The table can vanish under us at any moment — a stray
            # `nft flush ruleset`, another admin, a tool that owns the ruleset.
            # Until this check existed, `enforcing` was computed only at apply
            # time, so the daemon would report "protected" forever while the
            # machine ran naked.
            if self.cfg["armed"] and not nft_present():
                log("reconcile: our ruleset is GONE — re-asserting immediately")
                self.ks.sync()
                self._fp = Net.fingerprint()
                return True
            fp = Net.fingerprint()
            if fp != self._fp:
                self._fp = fp
                if self.cfg["armed"]:
                    log("reconcile: network drifted without an event — re-syncing")
                    self._on_event()
        except Exception as e:  # noqa: BLE001
            log(f"reconcile error: {e}")
        return True                           # keep the timer alive

    def _emit_changed(self):
        if self.conn:
            self.conn.emit_signal(None, OBJ_PATH, IFACE, "Changed", None)

    # ---- D-Bus dispatch ----
    # The signature of the method-call closure varies across PyGObject versions
    # (with/without trailing user_data), so accept *args and pick fields by type.
    def _handle(self, *args):
        invocation = next(a for a in args if isinstance(a, Gio.DBusMethodInvocation))
        params = next((a for a in args if isinstance(a, GLib.Variant)), None)
        method = invocation.get_method_name()
        try:
            invocation.return_value(self._dispatch(method, params))
        except Exception as e:  # noqa: BLE001
            log(f"{method} failed: {e}")
            invocation.return_dbus_error(f"{IFACE}.Error", str(e))

    def _dispatch(self, method, params):
        cfg = self.cfg
        if method == "Arm":
            self.ks.arm(params.unpack()[0] or None)
            return None
        if method == "Disarm":
            self.ks.disarm()
            return None
        if method == "Apply":
            if cfg.promote() and cfg["armed"]:
                self.ks.sync()
            self._emit_changed()
            return None
        if method == "Revert":
            cfg["pending"] = {}
            cfg.save()
            self._emit_changed()
            return None
        if method == "Confirm":
            self.ks.confirm()
            return None
        if method == "GetStatus":
            s = dict(self.ks.status)
            # INVARIANT 4/5: never serve a stale `enforcing` — ask the kernel at
            # read time, so a table that disappeared since the last apply shows
            # up right here instead of at the next tick.
            if s.get("armed"):
                s["enforcing"] = nft_present()
                if not s["enforcing"]:
                    s["detail"] = "NOT PROTECTED — ruleset missing, re-asserting"
            s["pending"] = len(cfg["pending"])
            var = {}
            for k, v in s.items():
                if isinstance(v, bool):
                    var[k] = GLib.Variant("b", v)
                elif isinstance(v, int):
                    var[k] = GLib.Variant("i", v)
                else:
                    var[k] = GLib.Variant("s", str(v))
            return GLib.Variant("(a{sv})", (var,))
        if method == "GetConfig":
            return GLib.Variant("(a{ss})", (cfg.flat(),))
        if method == "GetPending":
            return GLib.Variant("(a{ss})", ({k: str(v) for k, v in cfg["pending"].items()},))
        if method == "SetPending":
            key, val = params.unpack()
            cfg.set_pending(key, val)
            if cfg["instant_apply"]:
                if cfg.promote() and cfg["armed"]:
                    self.ks.sync()
            self._emit_changed()
            return None
        if method == "ListVpns":
            return GLib.Variant("(a(sss))", (Net.all_vpns(),))
        if method == "ListNodes":
            nodes = [{k: str(n.get(k, "")) for k in self.NODE_KEYS}
                     for n in cfg["nodes"]]
            return GLib.Variant("(aa{ss})", (nodes,))
        if method == "WriteNode":
            node = params.unpack()[0]
            name = (node.get("name") or "").strip()
            if not name:
                raise ValueError("node name required")
            if node.get("ip") and not is_literal_ip(node["ip"]):
                raise ValueError(f"not an IP address: {node['ip']}")
            entry = {k: str(node.get(k, "")).strip() for k in self.NODE_KEYS}
            entry["mac"] = entry["mac"].lower()
            cfg["nodes"] = [n for n in cfg["nodes"] if n.get("name") != name] + [entry]
            cfg.save()
            if cfg["armed"]:
                self.ks.sync()
            self._emit_changed()
            return None
        if method == "DeleteNode":
            name = params.unpack()[0]
            cfg["nodes"] = [n for n in cfg["nodes"] if n.get("name") != name]
            cfg.save()
            if cfg["armed"]:
                self.ks.sync()
            self._emit_changed()
            return None
        raise ValueError(f"unknown method {method}")


# ---------------------------------------------------------------------------
def restore_only():
    """Pre-network boot path: block first, ask questions later.

    Runs from kiwi-killswitch-boot.service, ordered before network-pre.target,
    so if we were armed at shutdown the machine comes up already blocked —
    there is no window between a NIC gaining carrier and the daemon getting
    around to loading a ruleset. The full daemon replaces this with the real
    ruleset a moment later.
    """
    cfg = Config()
    if not cfg["armed"]:
        return 0
    text = ""
    try:
        with open(BOOT_RULESET) as fh:
            text = fh.read()
    except OSError:
        pass
    if not text:
        text = Firewall(cfg).hard_block(cfg.settings())
    ok = nft_apply(text, path=BOOT_RULESET)
    log("boot: hard block loaded" if ok else "boot: FAILED to load the hard block")
    return 0 if ok else 1


def panic():
    """Undo everything, as directly as possible, and stay out of the way.

    The recovery path for "I am locked out and the daemon may be wedged". It
    does not talk to the daemon over D-Bus — it stops it, tears the rules down
    itself, clears the persisted intent so a restart does not immediately
    re-block, and puts DNS and routing back. Then it starts the daemon again so
    the machine is left in a working, disarmed state rather than a half one.

    Root only, and it genuinely removes your protection. That is the point.
    """
    log("PANIC: removing all kill switch state")
    run(["systemctl", "stop", "kiwi-killswitchd.service"])
    nft_drop_tables()
    cfg = Config()
    ks = KillSwitch(cfg, None)
    try:
        ks._del_mgmt_routes()
        ks.dns.clear()
    except Exception as e:  # noqa: BLE001 — never let cleanup stop the teardown
        log(f"panic: cleanup error (continuing): {e}")
    cfg["armed"] = False
    cfg.save()
    nft_drop_tables()
    run(["systemctl", "start", "kiwi-killswitchd.service"])
    log("PANIC: done — this machine is NOT protected")
    return 0


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--restore-only", action="store_true",
                    help="load the pre-network hard block and exit (boot unit)")
    ap.add_argument("--panic", action="store_true",
                    help="tear everything down and leave the machine unprotected")
    args = ap.parse_args()

    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    if os.geteuid() != 0:
        log("must run as root")
        return 1
    os.makedirs(STATE_DIR, exist_ok=True)

    if args.restore_only:
        return restore_only()
    if args.panic:
        return panic()

    svc = Service()
    svc.start()
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
