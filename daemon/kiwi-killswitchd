class Firewall:
    """Builds the nftables rulesets.

    Everything is emitted into ONE `nft -f` file so the swap is a single netlink
    transaction: there is never a moment where the old rules are gone but the
    new ones are not in place yet. The `add table` + `delete table` + re-add
    idiom is what makes that idempotent (`add table` is a no-op if it exists,
    unlike `add chain`, so the `delete` below it is always safe).

    Every token that originates outside this file — a subnet, a port, an
    address, an interface name — is re-validated here on its way in, whatever
    was checked when it was stored. The config can predate the checks, and one
    token nft dislikes costs the whole transaction.
    """

    def __init__(self, cfg):
        self.cfg = cfg

    # ---- small emitters ----
    @staticmethod
    def _set(names):
        return "{ %s }" % ", ".join(f'"{n}"' for n in names)

    @staticmethod
    def _addr_rules(ips, tail, comment, head=""):
        """One rule per family; nft will not mix ip and ip6 in a set."""
        out = []
        ips = [a for a in dict.fromkeys(ips) if is_literal_ip(a)]
        for fam, sel in (("ip", False), ("ip6", True)):
            batch = [a for a in ips if is_ipv6(a) == sel]
            if not batch:
                continue
            addrs = "{ %s }" % ", ".join(batch) if len(batch) > 1 else batch[0]
            out.append(f'    {head}{fam} daddr {addrs} {tail}accept comment "{comment}"')
        return out

    @staticmethod
    def _subnet_rules(subnets, comment, sel="daddr", tail=""):
        out = []
        for sn in dict.fromkeys(n for n in map(norm_subnet, subnets) if n):
            fam = "ip6" if is_ipv6(sn) else "ip"
            out.append(f'    {fam} {sel} {sn} {tail}accept comment "{comment}"')
        return out

    def _endpoint_rules(self, eps, comment):
        """The selected VPN's server — and only the protocol and port the tunnel
        itself uses, wherever we know them.

        An address-only rule lets ANY traffic to that host leave around the
        tunnel while it is down. A VPN server that also serves a website — the
        normal case for a self-hosted one — would be talked to in the clear,
        from the real address. An endpoint whose port we could not determine
        still gets the address-only rule rather than none: a tunnel that cannot
        connect is the one failure that pushes people to disarm."""
        groups = {}
        for ip, proto, port in eps:
            groups.setdefault((proto, port), []).append(ip)
        out = []
        for (proto, port), ips in groups.items():
            tail = (f"{proto} dport {port} "
                    if proto in ("udp", "tcp") and valid_port(str(port)) else "")
            out += self._addr_rules(ips, tail, comment)
        return out

    @staticmethod
    def _offtunnel_resolver(ev):
        """The resolver, if it needs a rule of its own — i.e. when it is NOT
        reached through a tunnel exit.

        Through the tunnel the exit accept already covers it, and a separate
        address rule is worse than redundant: it is not tied to an interface,
        so in the moment a tunnel dies — before the ruleset is rebuilt — it
        would let lookups for that address leave on the physical NIC."""
        if not is_literal_ip(ev.resolver):
            return ""
        if ev.complete and ev.exit_is_tunnel and ev.dns_link == ev.exit_iface:
            return ""
        return ev.resolver

    def _dns_backstop(self, ev):
        """Drop DNS toward anything but the chosen resolver.

        Must sit BEFORE the bypass/mgmt/LAN accepts, otherwise those holes are
        also DNS holes. It cannot sit before the exit accept — DNS through the
        tunnel is the whole point of dns_mode=tunnel.

        Note what this does *not* have to cover: applications talk to
        systemd-resolved's stub on 127.0.0.53, which `oifname "lo"` always
        allows. The leak surface is resolved's own upstream query, and that is
        what these rules see."""
        out = []
        resolver = self._offtunnel_resolver(ev)
        if resolver:
            fam = "ip6" if is_ipv6(resolver) else "ip"
            out += [f'    {fam} daddr {resolver} udp dport 53 accept comment "resolver"',
                    f'    {fam} daddr {resolver} tcp dport {{ 53, 853 }} accept comment "resolver"']
        out += ['    udp dport 53 counter drop comment "dns backstop"',
                '    tcp dport { 53, 853 } counter drop comment "dns backstop"']
        return out

    # ---- the full fail-closed ruleset ----
    def full(self, ev, p, doh_ips):
        exits = [ev.exit_iface] if (ev.complete and valid_iface(ev.exit_iface)) else []
        bypass = subnets_of(p["bypass_subnets"])
        if truthy(p["allow_lan"]):
            bypass += Net.lan_subnets()
        mgmt = subnets_of(p["mgmt_subnets"])
        hardening = p["hardening"] if p["hardening"] in HARDENING_LEVELS else "strict"

        o = [f"table inet {TABLE} {{", "  chain output {",
             f"    type filter hook output priority {PRIO}; policy drop;",
             '    oifname "lo" accept',
             # INVARIANT 1: pinning this to the exit interface is load-bearing.
             # Unqualified, it is a PERMANENT leak: when the tunnel drops the
             # kernel reroutes every already-open flow onto the physical NIC,
             # those packets still match ESTABLISHED, and they leave with the
             # real source IP. Flushing conntrack is not a fix — the conntrack
             # binary is not in the Silverblue/Bluefin image, so any code path
             # depending on it is a silent no-op. Pinning fails closed either way.
             "    ct state established,related oifname %s accept"
             % self._set(["lo"] + exits)]
        if exits:
            o.append(f'    oifname {self._set(exits)} accept comment "exit"')
        # the selected VPN's server, over whatever uplink exists — the handshake
        # has to work before the tunnel it is building exists
        o += self._endpoint_rules(ev.endpoints, "vpn endpoint")
        if ev.hostnames and not exits:
            # The DoH hole exists for one caller (this daemon, root) at one
            # moment (a hostname endpoint to resolve while nothing carries
            # traffic). Open to every process all the time, it let anything on
            # the machine reach these resolvers from the real address while the
            # switch said "blocking everything".
            o += self._addr_rules(doh_ips, "tcp dport 443 ", "doh bootstrap",
                                  head="meta skuid 0 ")
        o += self._dns_backstop(ev)
        o += self._subnet_rules(bypass, "bypass")
        o += self._subnet_rules(mgmt, "mgmt")
        o += [
              # IPv6 has no ARP: the kernel resolves a next hop with ICMPv6,
              # and unlike ARP those packets DO pass this hook. Dropped, no
              # IPv6 neighbour is ever resolved and a VPN whose server is
              # reached over IPv6 cannot complete its handshake. Link scope
              # only (hop limit 255) — they cannot leave the segment.
              "    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, "
              'nd-router-solicit } accept comment "l2"',
              '    udp sport 68 udp dport 67 accept comment "dhcp4"',
              '    udp sport 546 udp dport 547 accept comment "dhcp6"',
              '    counter comment "ks-drop-out"',
              "  }"]

        # ---- input ----
        o += ["  chain input {",
              f"    type filter hook input priority {PRIO}; policy drop;",
              '    iifname "lo" accept']
        if truthy(p["strict_input"]) and exits:
            # off by default: inbound acceptance is not a real-IP egress vector,
            # and scoping it raises the lockout risk on a remote box
            o.append("    ct state established,related iifname %s accept"
                     % self._set(["lo"] + exits))
        else:
            o.append("    ct state established,related accept")
        if exits:
            o.append(f'    iifname {self._set(exits)} accept comment "exit"')
        for prt in ports_of(p["allow_in_ports"]):
            o.append(f'    tcp dport {prt} accept comment "mgmt port"')
        o += self._subnet_rules(mgmt, "mgmt", sel="saddr")
        o += ['    udp sport 67 udp dport 68 accept comment "dhcp4"',
              '    udp sport 547 udp dport 546 accept comment "dhcp6"',
              "    icmp type { echo-reply, destination-unreachable, time-exceeded } accept",
              "    icmpv6 type { echo-reply, nd-neighbor-solicit, nd-neighbor-advert, "
              "nd-router-solicit, nd-router-advert, destination-unreachable, "
              "packet-too-big, time-exceeded } accept",
              '    counter comment "ks-drop-in"',
              "  }"]

        # ---- forward ----
        # ip_forward is 1 on a Bluefin-dx workstation (podman, waydroid, libvirt).
        # Forwarded packets never traverse the output hook, so without this chain
        # a container is a hole straight through the kill switch.
        if hardening in ("strict", "paranoid"):
            o += ["  chain forward {",
                  f"    type filter hook forward priority {PRIO}; policy drop;"]
            if exits:
                o += [f'    oifname {self._set(exits)} accept comment "forward via exit"',
                      f'    iifname {self._set(exits)} ct state established,related accept']
            o += self._subnet_rules(bypass, "bypass")
            # ...and the way back. Without it a guest could SEND to an allowed
            # network and never hear the answer. Established only, and only
            # from the allowed network itself, so this cannot carry anything
            # that was not let out by the rule above.
            o += self._subnet_rules(bypass, "bypass reply", sel="saddr",
                                    tail="ct state established,related ")
            o += ['    counter comment "ks-drop-fwd"', "  }"]
        o.append("}")

        return self._wrap(o, self.netdev(ev, p, doh_ips))

    def netdev(self, ev, p, doh_ips):
        """Per-NIC egress hook — the only layer that sees raw-socket traffic.

        The `inet output` hook cannot see AF_PACKET egress: NetworkManager's own
        DHCP client and anything holding CAP_NET_RAW write frames straight to the
        device. The netdev egress hook sits on the device itself and sees them.

        Tunnelled traffic reaches this hook already ENCAPSULATED and addressed to
        the VPN endpoint, so `ip daddr <endpoint>` covers it — and by definition
        anything else leaving a physical NIC unencapsulated is a leak.

        Caveats baked into the shape below: conntrack does not exist in the
        netdev family, so matching is address/port only; and a chain naming a
        device the kernel does not have fails the WHOLE transaction, so chains
        are generated only for NICs that exist right now. LinkMonitor rebuilds
        on every NIC add/remove, and until it does the inet output chain still
        covers the newcomer.
        """
        if p["hardening"] != "paranoid":
            return []
        allow = subnets_of(p["bypass_subnets"]) + subnets_of(p["mgmt_subnets"])
        if truthy(p["allow_lan"]):
            allow += Net.lan_subnets()
        resolver = self._offtunnel_resolver(ev)
        if resolver:
            allow.append(resolver + ("/128" if is_ipv6(resolver) else "/32"))
        # a trusted node's uplink IS the permitted exit — filtering it here
        # would cut the very path we just decided to trust. The hook lives on
        # the real card, so for a bridged or bonded uplink that means the
        # card(s) underneath it.
        open_nics = (Net.physical_under(ev.exit_iface)
                     if ev.complete and not ev.exit_is_tunnel else set())

        o = [f"table netdev {NETDEV_TABLE} {{"]
        for nic in Net.physical_nics():
            if nic in open_nics:
                continue
            if not valid_iface(nic):
                log_once(f"nic:{nic}", f"netdev: cannot name {nic!r} in a ruleset "
                                       "— that card is covered by the inet layer only")
                continue
            o += [f"  chain egress_{nft_ident(nic)} {{",
                  f'    type filter hook egress device "{nic}" priority 0; policy drop;',
                  '    ether type arp accept comment "l2"',
                  # wpa_supplicant writes EAPOL straight to the device, so
                  # WPA-Enterprise cannot associate at all if we drop it here —
                  # and it carries no IP payload, so it cannot leak an address
                  '    ether type 0x888e accept comment "eapol"',
                  "    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, "
                  'nd-router-solicit } accept comment "l2"',
                  '    udp sport 68 udp dport 67 accept comment "dhcp4"',
                  '    udp sport 546 udp dport 547 accept comment "dhcp6"']
            o += self._endpoint_rules(ev.endpoints, "encapsulated vpn")
            if ev.hostnames and not ev.complete:
                # no socket owner to match on down here, and none needed:
                # whatever reaches this hook either passed the inet rule (root
                # only) or came from a raw socket, which is root already
                o += self._addr_rules(doh_ips, "tcp dport 443 ", "doh bootstrap")
            o += self._subnet_rules(allow, "allowed")
            o += ['    counter comment "ks-drop-egress"', "  }"]
        o.append("}")
        return o if len(o) > 2 else []

    @staticmethod
    def node_dns(ev):
        addr = str((ev.node or {}).get("dns") or ev.resolver or "")
        return addr if is_literal_ip(addr) else ""

    def node(self, ev, p):
        """Node mode: WAN stays open, DNS is forced to the kiwi-node.

        A lightweight "I am on my own network, just stop DNS wandering off"
        mode — not a kill switch, and the status text must never imply it is."""
        addr = self.node_dns(ev)
        o = [f"table inet {TABLE} {{", "  chain output {",
             f"    type filter hook output priority {PRIO}; policy accept;",
             '    oifname "lo" accept']
        if addr:
            fam = "ip6" if is_ipv6(addr) else "ip"
            o += [f'    {fam} daddr {addr} udp dport 53 accept comment "node dns"',
                  f'    {fam} daddr {addr} tcp dport {{ 53, 853 }} accept comment "node dns"']
        o += ['    udp dport 53 counter drop comment "force dns to the node"',
              '    tcp dport { 53, 853 } counter drop comment "force dns to the node"',
              "  }", "}"]
        return self._wrap(o, [])

    def hard_block(self, p):
        """The fallback when a ruleset is rejected, and what the boot unit loads.

        Deliberately minimal — no endpoints, no bypass, no DNS, mgmt only. The
        parts most likely to have been rejected are gone, so this almost always
        loads, and blocking is the only safe answer at that point."""
        p = p or {}
        mgmt = subnets_of(p.get("mgmt_subnets", ""))
        o = [f"table inet {TABLE} {{", "  chain output {",
             f"    type filter hook output priority {PRIO}; policy drop;",
             '    oifname "lo" accept',
             '    ct state established,related oifname "lo" accept']
        o += self._subnet_rules(mgmt, "mgmt")
        o += ['    udp sport 68 udp dport 67 accept comment "dhcp4"',
              '    counter comment "ks-drop-out"',
              "  }", "  chain input {",
              f"    type filter hook input priority {PRIO}; policy drop;",
              '    iifname "lo" accept',
              "    ct state established,related accept"]
        for prt in ports_of(p.get("allow_in_ports", "")):
            o.append(f'    tcp dport {prt} accept comment "mgmt port"')
        o += self._subnet_rules(mgmt, "mgmt", sel="saddr")
        o += ['    counter comment "ks-drop-in"', "  }", "  chain forward {",
              f"    type filter hook forward priority {PRIO}; policy drop;",
              '    counter comment "ks-drop-fwd"', "  }", "}"]
        return self._wrap(o, [])

    def lockdown(self):
        """The last resort: loopback and DHCP, built from no input at all.

        hard_block() still carries the management subnets and ports. Both are
        sanitised on the way in now — but "the fallback embeds the same value
        that broke the real ruleset" is exactly how a typo once left an armed
        machine with no table, so there is one more rung below it that no
        setting can reach, because it contains none. It will cut a remote
        session. When this is all that loads, that is the right trade."""
        o = [f"table inet {TABLE} {{", "  chain output {",
             f"    type filter hook output priority {PRIO}; policy drop;",
             '    oifname "lo" accept',
             '    udp sport 68 udp dport 67 accept comment "dhcp4"',
             '    counter comment "ks-drop-out"',
             "  }", "  chain input {",
             f"    type filter hook input priority {PRIO}; policy drop;",
             '    iifname "lo" accept',
             '    udp sport 67 udp dport 68 accept comment "dhcp4"',
             '    counter comment "ks-drop-in"',
             "  }", "  chain forward {",
             f"    type filter hook forward priority {PRIO}; policy drop;",
             '    counter comment "ks-drop-fwd"', "  }", "}"]
        return self._wrap(o, [])

    @staticmethod
    def _wrap(inet_lines, netdev_lines):
        """Atomic swap for both tables in one transaction.

        The netdev table is add+delete'd with no re-add when it is not wanted,
        which is how a hardening downgrade removes it in the same transaction
        that installs the new inet table — never leaving a stale egress chain
        filtering against an old endpoint."""
        head = (f"add table inet {TABLE}\ndelete table inet {TABLE}\n"
                f"add table netdev {NETDEV_TABLE}\n"
                f"delete table netdev {NETDEV_TABLE}\n")
        body = "\n".join(inet_lines) + "\n"
        if netdev_lines:
            body += "\n".join(netdev_lines) + "\n"
        return head + body


# ---------------------------------------------------------------------------
class Dns:
    """Steer systemd-resolved. No interception, no dnsmasq, no NM edits.

    resolved runs in stub mode here, so applications always talk to 127.0.0.53
    — which `oifname "lo"` permits unconditionally. What actually leaves the
    machine is resolved's own upstream query, and the only thing that decides
    where that goes is resolved's per-link configuration. So we set it directly.

    Everything is done at runtime with `resolvectl` and undone with
    `resolvectl revert`. We deliberately do NOT touch `nmcli connection modify
    … ipv4.ignore-auto-dns`: that rewrites the saved profile and needs a
    reactivation to take effect, i.e. the daemon would have to bounce the user's
    connection — the one thing this design promises never to do.
    """

    def __init__(self, cfg):
        self.cfg = cfg
        self._applied = None        # what resolved was last pointed at

    @property
    def touched(self):
        return self.cfg["runtime"]["dns_links"]

    def _mark(self, link):
        if link not in self.touched:
            self.touched.append(link)
            self.cfg.save()

    @staticmethod
    def _links():
        out = []
        for ln in run(["ip", "-o", "link", "show", "up"]).stdout.splitlines():
            f = ln.split(": ")
            if len(f) > 1:
                name = f[1].split("@")[0]
                if name != "lo":
                    out.append(name)
        return out

    def apply(self, ev, p):
        if not (ev.dns_link and is_literal_ip(ev.resolver)):
            # nothing trustworthy to point at: leave resolved alone and let the
            # nft backstop drop the queries. Status says "blocked" rather than
            # pretending DNS works.
            self.clear()
            return
        link = ev.dns_link
        doms = ["~."] + [d for d in str(p["dns_search"]).split()
                         if d == "~." or _HOST_RE.match(d.lstrip("~"))]
        dot = truthy(p["dns_dot"])
        for other in self._links():
            if other == link:
                continue
            # stop resolved from consulting any other link for general queries;
            # this is what keeps the LAN's own resolver out of the picture
            # without rewriting the NetworkManager profile
            run(["resolvectl", "default-route", other, "no"])
            self._mark(other)
        # The settings are re-asserted every time — NetworkManager pushes its
        # own view to resolved whenever it likes — but they are idempotent.
        run(["resolvectl", "dns", link, ev.resolver])
        run(["resolvectl", "domain", link] + doms)
        run(["resolvectl", "default-route", link, "yes"])
        run(["resolvectl", "dnsovertls", link, "yes" if dot else "no"])
        self._mark(link)
        # The cache is another matter: flushing it throws away every answer
        # the machine has. Only when the path actually changed.
        want = (link, ev.resolver, tuple(doms), dot)
        if want != self._applied:
            self._applied = want
            run(["resolvectl", "flush-caches"])
            log(f"dns: {ev.dns_path} via {ev.resolver} on {link}")

    def clear(self):
        self._applied = None
        if not self.touched:
            return
        for link in sorted(self.touched):
            run(["resolvectl", "revert", link])
            # `resolvectl revert` is not the clean undo it looks like: it drops
            # NetworkManager's OWN servers along with ours, and NM never
            # notices — not on a reapply, not on a reconnect. The link is left
            # with no resolver at all and DNS breaks system-wide, long after
            # the kill switch is disarmed. (Verified on the test box: revert
            # left enp1s0 with zero servers and `Default Route: no`.) So put
            # NM's answer back ourselves. Restoring the servers is also what
            # makes resolved recompute DefaultRoute as yes again.
            servers = Net.device_dns(link)
            if servers:
                run(["resolvectl", "dns", link] + servers)
            domains = Net.device_domains(link)
            if domains:
                run(["resolvectl", "domain", link] + domains)
        del self.touched[:]
        self.cfg.save()
        run(["resolvectl", "flush-caches"])
        log("dns: restored NetworkManager's settings")


