# firewalld puts its own filter chains at priority 10 (NFT_HOOK_OFFSET). We sit in
# front of it at -10: a `drop` is terminal across base chains, while an `accept`
# only ends the current chain — so we block what must be blocked and firewalld
# still gets to filter whatever we let through.
PRIO = -10

DEBOUNCE_MS = 1200        # collapse event bursts
DEBOUNCE_MAX_MS = 5000    # ...but never sit on a pending event longer than this
RECONCILE_SEC = 15        # safety net: catch anything both watchers miss
RESYNC_SEC = 300          # ...and re-evaluate from scratch this often regardless
RESOLVE_TTL = 120         # ask DoH about one hostname endpoint at most this often
