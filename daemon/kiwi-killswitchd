class Config:
    def __init__(self):
        self.data = json.loads(json.dumps(DEFAULTS))   # deep copy
        self.load()

    def load(self):
        try:
            with open(CONFIG_JSON) as fh:
                loaded = json.load(fh)
            for k, v in loaded.items():
                self.data[k] = v
        except (OSError, ValueError):
            pass
        self.data.setdefault("nodes", [])
        self.data.setdefault("endpoint_cache", {})
        self.data.setdefault("pending", {})
        rt = self.data.setdefault("runtime", {})
        rt.setdefault("dns_links", [])
        rt.setdefault("mgmt_routes", [])

    def save(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = CONFIG_JSON + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(self.data, fh, indent=2, sort_keys=True)
        os.replace(tmp, CONFIG_JSON)
        os.chmod(CONFIG_JSON, 0o644)

    def __getitem__(self, k):
        return self.data.get(k, DEFAULTS.get(k))

    def __setitem__(self, k, v):
        self.data[k] = v

    # ---- settings ----
    def settings(self):
        """The effective settings, as a plain dict. Never a live reference."""
        return {k: self[k] for k in SETTABLE}

    def flat(self):
        """The settings as strings, for D-Bus.

        This is what is IN EFFECT — staged changes are deliberately not merged
        in. `kiwi-killswitch config` showing a value that is not actually
        enforced yet is precisely the confusion the staging model exists to
        prevent. Callers that want the prospective view read GetPending too and
        overlay it themselves, which is what the settings app does so it can
        mark those rows."""
        return {k: self._str(self[k]) for k in SETTABLE}

    # ---- staging ----
    def set_pending(self, key, value):
        if key not in SETTABLE:
            raise ValueError(f"unknown key {key}")
        if key == "hardening" and value not in HARDENING_LEVELS:
            raise ValueError(f"hardening must be one of {', '.join(HARDENING_LEVELS)}")
        self["pending"][key] = str(value)
        self.save()

    def promote(self):
        """Merge staged changes into the live settings. True if anything moved."""
        pend = self["pending"]
        if not pend:
            return False
        was_hardening = self["hardening"]
        for k, v in pend.items():
            if k in SETTABLE:
                self[k] = truthy(v) if k in BOOLS else v
        if self["hardening"] not in HARDENING_LEVELS:
            self["hardening"] = "strict"
        # Escalating INTO paranoid is provisional again, even if it was
        # confirmed before: the netdev chain is built from the allow-list, so a
        # setup confirmed under a different mgmt_subnets can lock the machine
        # out today. Confirming is cheap; being locked out of a headless box
        # is not.
        if (self["hardening"] == "paranoid" and was_hardening != "paranoid"
                and "hardening_confirmed" not in pend):
            self["hardening_confirmed"] = False
        self["pending"] = {}
        self.save()
        return True

    @staticmethod
    def _str(v):
        if isinstance(v, bool):
            return "1" if v else "0"
        return str(v)


# ---------------------------------------------------------------------------
class Net:
    """Thin NetworkManager / ip / wg helpers — nmcli + ip only (base image)."""

    VPN_TYPES = ("wireguard", "vpn", "openvpn", "tun")

    @staticmethod
    def active_vpns():
        r = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"])
        out = []
        for line in r.stdout.splitlines():
            name, _, typ = line.partition(":")
            if any(t in typ for t in Net.VPN_TYPES):
                out.append(name)
        return out

    @staticmethod
    def all_vpns():
        r = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"])
        active = set(Net.active_vpns())
        out = []
        for line in r.stdout.splitlines():
            name, _, typ = line.partition(":")
            if any(t in typ for t in Net.VPN_TYPES):
                out.append((name, typ, "yes" if name in active else "no"))
        return out

    @staticmethod
    def conn_active(conn):
        return conn in Net.active_vpns()

    @staticmethod
    def iface_up(ifc):
        """Is this link actually usable right now?

        `ip link show <dev> up` is a trap: with the `up` filter it exits 0 and
        prints NOTHING when the device exists but is down, so its return code
        means "the device exists", not "the device is up". Reading it as
        liveness is silent and costly — a tunnel taken down at the link level
        keeps its address, so it still looks alive, the ruleset goes on
        pointing at a dead interface, and status reports "protected via tun0"
        while nothing is being protected at all. Parse the flags instead.

        Verified on the test box: a downed WireGuard link shows
        `<POINTOPOINT,NOARP>` and `ip link show <dev> up` still exits 0.
        """
        r = run(["ip", "-o", "link", "show", "dev", ifc])
        if r.returncode != 0:
            return False
        flags = r.stdout.partition("<")[2].partition(">")[0].split(",")
        return "UP" in flags and "NO-CARRIER" not in flags

    @staticmethod
    def is_tunnel(ifc):
        """INVARIANT 2: a tunnel is never a physical NIC. Physical devices have a
        backing device in sysfs; tun/tap/wg/ppp do not — this beats a name
        whitelist, which rejects legitimately-named tunnels (nordlynx, proton0)."""
        if not ifc or ifc == "lo":
            return False
        return not os.path.exists(f"/sys/class/net/{ifc}/device")

    @staticmethod
    def physical_nics():
        """Real NICs, for the netdev egress hook. Only links that exist right now
        — a chain naming a device the kernel does not have fails the whole
        transaction."""
        try:
            names = sorted(os.listdir("/sys/class/net"))
        except OSError:
            return []
        return [n for n in names
                if n != "lo" and os.path.exists(f"/sys/class/net/{n}/device")]

    @staticmethod
    def _addr_owner(addrs):
        if not addrs:
            return ""
        for ln in run(["ip", "-o", "addr", "show"]).stdout.splitlines():
            f = ln.split()
            if len(f) > 3 and f[3].split("/")[0] in addrs:
                return f[1]
        return ""

    @staticmethod
    def ip_iface(conn):
        """The REAL tunnel interface of a connection.

        INVARIANT 2: nmcli's GENERAL.IP-IFACE is the device a connection is
        *bound to*, and for plugin VPNs (OpenVPN) that is the physical NIC — it
        answers 'enp3s0' while the tunnel lives on tun0. Taking it at face value
        and then discarding it as "not a tunnel" leaves the switch armed with NO
        exit interface: everything blocked, and the user's only way back online
        is to disarm, which is exactly when the real IP is exposed.

        So: locate the tunnel by the address NM assigned to the connection (that
        address is owned by the tunnel link itself), fall back to the VPN
        gateway's route, and only then to IP-IFACE — which is still correct for
        NM-native WireGuard, where the connection's device IS the tunnel.
        """
        out = run(["nmcli", "-t", "-f", "IP4.ADDRESS,IP6.ADDRESS,IP4.GATEWAY",
                   "connection", "show", conn]).stdout
        addrs, gw = set(), ""
        for ln in out.splitlines():
            key, _, val = ln.partition(":")
            val = val.strip()
            if not val:
                continue
            if key.startswith(("IP4.ADDRESS", "IP6.ADDRESS")):
                a = val.split("/")[0]
                if not a.lower().startswith("fe80:"):   # link-local names nothing
                    addrs.add(a)
            elif key.startswith("IP4.GATEWAY"):
                gw = val
        ifc = Net._addr_owner(addrs)
        if not ifc and gw:
            p = run(["ip", "route", "get", gw]).stdout.split()
            if "dev" in p:
                ifc = p[p.index("dev") + 1]
        if not ifc:
            ifc = run(["nmcli", "-t", "-f", "GENERAL.IP-IFACE", "connection",
                       "show", conn]).stdout.partition(":")[2].strip()
        return ifc

    @staticmethod
    def iface_subnets(ifc):
        r = run(["ip", "-o", "addr", "show", "dev", ifc])
        return [ln.split()[3] for ln in r.stdout.splitlines() if len(ln.split()) > 3]

    @staticmethod
    def static_endpoints(spec):
        """INVARIANT 6: endpoints from the connection's SAVED config, so they work
        while the connection is inactive — the fail-closed firewall must permit
        the handshake before the tunnel exists."""
        eps = []
        out = run(["nmcli", "-t", "-f", "wireguard.peers", "connection",
                   "show", spec]).stdout
        for m in re.finditer(r"endpoint=([^,\s]+)", out):
            eps.append(m.group(1))
        if not eps:
            data = run(["nmcli", "-t", "-f", "vpn.data", "connection",
                        "show", spec]).stdout
            # nmcli separates vpn.data keys with ", " and escapes commas INSIDE a
            # value as "\," — the remote value ends at the first unescaped ", ".
            m = re.search(r"remote = ((?:\\,|[^,])+)", data)
            if m:
                eps = [r0.strip() for r0 in m.group(1).split("\\,")]
        return eps

    @staticmethod
    def resolve_layer(spec):
        """(iface, [endpoint hostnames/ips]) for a VPN connection or raw iface."""
        iface, eps = "", []
        if run(["wg", "show", spec]).returncode == 0:          # native wg iface
            iface = spec
            r = run(["wg", "show", spec, "endpoints"])
            eps = [l.split()[1] for l in r.stdout.splitlines() if len(l.split()) > 1]
        elif Net.conn_active(spec):
            iface = Net.ip_iface(spec)
            if iface and Net.iface_up(iface) and run(["wg", "show", iface]).returncode == 0:
                r = run(["wg", "show", iface, "endpoints"])
                eps = [l.split()[1] for l in r.stdout.splitlines() if len(l.split()) > 1]
        elif spec and Net.iface_up(spec):
            iface = spec
        if not eps:
            eps = Net.static_endpoints(spec)

        if iface and not Net.iface_up(iface):
            iface = ""
        # SECURITY: reject a physical NIC masquerading as the tunnel — accepting
        # one would turn the "exit interface" rule into "allow everything out".
        if iface and not Net.is_tunnel(iface):
            log(f"ignoring non-tunnel iface '{iface}' for '{spec}'")
            iface = ""

        clean = []
        for e in eps:
            e = e.rsplit(":", 1)[0].strip("[]")     # drop :port, unwrap [v6]
            if valid_endpoint(e):
                clean.append(e)
            elif e:
                log(f"dropping invalid endpoint token {e!r} for '{spec}'")
        return iface, list(dict.fromkeys(clean))

    @staticmethod
    def default_routes():
        """Every default route, lowest metric (= what the kernel picks) first.

        Parsing the whole output as one blob and taking the first via/dev is a
        trap: with a VPN up there are two default routes, so it reports the
        TUNNEL's gateway and every trusted-gateway check breaks exactly when a
        VPN is connected."""
        out = []
        for ln in run(["ip", "-o", "route", "show", "default"]).stdout.splitlines():
            p = ln.split()
            gw = p[p.index("via") + 1] if "via" in p else ""
            dev = p[p.index("dev") + 1] if "dev" in p else ""
            try:
                metric = int(p[p.index("metric") + 1]) if "metric" in p else 0
            except (ValueError, IndexError):
                metric = 0
            if dev:
                out.append((gw, dev, metric))
        return sorted(out, key=lambda r: r[2])

    @staticmethod
    def default_gw():
        r = Net.default_routes()
        return (r[0][0], r[0][1]) if r else ("", "")

    @staticmethod
    def physical_gw():
        """The uplink *underneath* any tunnel. Management routes must use this,
        else they follow a full-tunnel default route into the VPN and the box
        drops off its admin LAN the moment you arm."""
        for gw, dev, _m in Net.default_routes():
            if gw and not Net.is_tunnel(dev):
                return gw, dev
        return "", ""

    @staticmethod
    def lan_subnets():
        """On-link subnets of the physical NICs (for allow_lan / netdev)."""
        out = []
        for ln in run(["ip", "-o", "-4", "addr", "show", "scope", "global"]).stdout.splitlines():
            f = ln.split()
            if len(f) > 3 and not Net.is_tunnel(f[1]):
                net = ipaddress.ip_network(f[3], strict=False)
                out.append(str(net))
        return list(dict.fromkeys(out))

    @staticmethod
    def route_dev(addr="192.0.2.1"):
        """Which interface the kernel would actually use to reach `addr`.

        This is a FIB lookup, not a packet — nothing is contacted, and the
        default is a TEST-NET address that is not routed anywhere anyway.

        Ask the kernel rather than comparing route metrics. Metrics are not the
        whole story: policy rules (`ip rule`) outrank them entirely — a WireGuard
        connection or Tailscale will happily install rules that send everything
        somewhere the metric table does not predict — and NetworkManager rewrites
        metrics from under you on reactivation. Observed on the test box: the
        same uplink reported metric 20106 and then 106 minutes apart, while the
        kernel's answer stayed correct throughout.
        """
        p = run(["ip", "route", "get", addr]).stdout.split()
        return p[p.index("dev") + 1] if "dev" in p else ""

    @staticmethod
    def is_onlink(subnet):
        """Is this subnet one of THIS machine's own attached networks?

        Such a subnet must never be pinned through a gateway: the kernel
        already reaches it directly, and forcing it via a router breaks return
        traffic outright.

        The case that bites is a libvirt or podman bridge. `is_tunnel()` works
        by "has no backing device in sysfs", which is the right test for
        spotting a real tunnel but also true of every bridge — so the naive
        "is this routed via a tunnel" question answers *yes* for a NAT'd VM's
        own subnet, and the pin then routes the VM network out the physical NIC
        and severs the host from its guests. The same reasoning protects the
        admin LAN, which is normally on-link too.
        """
        try:
            net = ipaddress.ip_network(subnet, strict=False)
        except ValueError:
            return False
        for ln in run(["ip", "-o", "addr", "show", "scope", "global"]).stdout.splitlines():
            f = ln.split()
            if len(f) < 4:
                continue
            try:
                local = ipaddress.ip_network(f[3], strict=False)
            except ValueError:
                continue
            if local.version != net.version:
                continue
            if net.subnet_of(local) or local.subnet_of(net):
                return True
        return False

    @staticmethod
    def routed_via_tunnel(subnet):
        p = run(["ip", "route", "get", subnet.split("/")[0]]).stdout.split()
        return "dev" in p and Net.is_tunnel(p[p.index("dev") + 1])

    @staticmethod
    def mac_of(ip):
        run(["ping", "-c1", "-W1", ip])
        p = run(["ip", "neigh", "show", ip]).stdout.split()
        return p[p.index("lladdr") + 1].lower() if "lladdr" in p else ""

    @staticmethod
    def reachable(addr):
        return run(["ping", "-c1", "-W1", addr.split("/")[0]]).returncode == 0

    @staticmethod
    def conn_for_dev(dev):
        for ln in run(["nmcli", "-t", "-f", "NAME,DEVICE", "connection", "show",
                       "--active"]).stdout.splitlines():
            name, _, d = ln.rpartition(":")
            if d == dev:
                return name
        return ""

    @staticmethod
    def conn_dns(conn):
        """DNS servers NM has for a connection (what the VPN pushed)."""
        out = []
        for ln in run(["nmcli", "-t", "-f", "IP4.DNS,IP6.DNS", "connection",
                       "show", conn]).stdout.splitlines():
            _, _, val = ln.partition(":")
            val = val.strip()
            if is_literal_ip(val):
                out.append(val)
        return out

    @staticmethod
    def device_dns(dev):
        """The resolvers NetworkManager configured on this device.

        `connection show` is the wrong question here — we need what is live on
        the link so we can put it back exactly."""
        out = []
        for ln in run(["nmcli", "-t", "-f", "IP4.DNS,IP6.DNS", "device", "show",
                       dev]).stdout.splitlines():
            _, _, val = ln.partition(":")
            val = val.strip()
            if is_literal_ip(val):
                out.append(val)
        return out

    @staticmethod
    def device_domains(dev):
        out = []
        for ln in run(["nmcli", "-t", "-f", "IP4.DOMAIN,IP6.DOMAIN", "device",
                       "show", dev]).stdout.splitlines():
            _, _, val = ln.partition(":")
            val = val.strip()
            if val:
                out.append(val)
        return out

    @staticmethod
    def fingerprint():
        """Cheap snapshot of everything the ruleset depends on: which links are
        up, what addresses they carry, and where the default route points."""
        return (run(["ip", "-o", "link", "show", "up"]).stdout
                + run(["ip", "-o", "addr", "show"]).stdout
                + run(["ip", "-o", "route", "show", "default"]).stdout)


