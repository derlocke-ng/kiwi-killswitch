        pp.set_vexpand(True)
        box.append(pp)

        tb = Adw.ToolbarView(content=box)
        h = Adw.HeaderBar()
        h.set_title_widget(Adw.WindowTitle(title="Kiwi Kill Switch",
                                           subtitle="VPN leak protection"))
        tb.add_top_bar(h)
        return Adw.NavigationPage(child=tb, title="Kiwi Kill Switch")

    # ---------------- the connection list ----------------
    def _rebuild_vpn_list(self):
        """One checkable row per VPN connection NetworkManager knows about.

        Rebuilt on every refresh so it tracks connections appearing, vanishing
        and connecting without the user reopening anything."""
        for row in self._vpn_rows:
            self.vpn_group.remove(row)
        self._vpn_rows = []
        self._vpn_checks = []

        try:
            vpns = list(self.d.list_vpns())
        except GLib.Error:
            vpns = []
        current = self._val("vpn")
        live = str(self._status.get("exit_iface") or "")
        armed = bool(self._status.get("armed"))

        if not vpns:
            row = Adw.ActionRow(
                title="No VPN connections yet",
                subtitle="Add a WireGuard or OpenVPN connection in "
                         "GNOME Settings → Network, then come back")
            row.add_prefix(Gtk.Image(icon_name="dialog-information-symbolic"))
            self.vpn_group.add(row)
            self._vpn_rows.append(row)
            return

        for name, typ, active in vpns:
            connected = active == "yes"
            row = Adw.ActionRow(title=name)
            row.set_subtitle(typ.replace("wireguard", "WireGuard")
                                .replace("vpn", "OpenVPN / plugin"))

            chk = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            chk.set_active(name == current)
            chk.connect("toggled", self._on_vpn_toggled, name)
            row.add_prefix(chk)

            pill = Gtk.Label(valign=Gtk.Align.CENTER)
            pill.add_css_class("ks-pill")
            if armed and name == current and live:
                pill.set_label("PROTECTING")
                pill.add_css_class("now")
            elif connected:
                pill.set_label("CONNECTED")
                pill.add_css_class("on")
            else:
                pill.set_label("OFF")
                pill.add_css_class("off")
            row.add_suffix(pill)

            row.set_activatable_widget(chk)
            self._mark(row, "vpn")
            self.vpn_group.add(row)
            self._vpn_rows.append(row)
            self._vpn_checks.append((chk, name))

    def _on_vpn_toggled(self, btn, name):
        """Checkboxes, but only one may be ticked.

        A radio group would enforce that for free and cannot express "none",
        which is a real choice here — you may be relying on a trusted node
        instead. So: plain checkboxes, single selection enforced by hand."""
        if self._loading or self._vpn_sync:
            return
        self._vpn_sync = True
        try:
            if btn.get_active():
                for other, other_name in self._vpn_checks:
                    if other_name != name and other.get_active():
                        other.set_active(False)
                target = name
            else:
                target = ""
        finally:
            self._vpn_sync = False
        if self._val("vpn") != target:
            self._stage("vpn", target)

    def _push(self, builder):
        self._reload()
        self.nav.push(builder())

    def _repush(self, builder):
        """Rebuild the page we are on, so it always shows current state."""
        self.nav.pop()
        self._push(builder)

    def _refresh(self):
        self._loading = True
        try:
            st = self.d.status()
            self._reload()
        except GLib.Error as e:
            self._status = {}
            self._set_hero("off", "dialog-question-symbolic", "Daemon unavailable",
                           "Cannot reach kiwi-killswitchd. "
                           "Start it: sudo systemctl enable --now kiwi-killswitchd")
            self.arm_switch.set_sensitive(False)
            self._loading = False
            # name ownership on the bus is asynchronous, so a call issued in the
            # first moments can legitimately fail. Retry rather than leaving a
            # dead window that only a restart fixes.
            GLib.timeout_add(1000, self._refresh)
            return False

        self._status = st
        self.arm_switch.set_sensitive(True)
        armed = bool(st.get("armed"))
        enforcing = bool(st.get("enforcing"))
        detail = str(st.get("detail", ""))
        self.arm_switch.set_active(armed)

        if not armed:
            self._set_hero("off", "changes-allow-symbolic", "Not protecting",
                           "Normal networking. Pick a connection below and turn "
                           "this on.")
        elif not enforcing:
            # INVARIANT 5: armed-but-not-enforcing looks safe and is not. This
            # is the one state the UI must never soften.
            self._set_hero("bad", "dialog-error-symbolic", "NOT PROTECTED",
                           f"{detail}\nCheck: journalctl -u kiwi-killswitchd")
        elif not st.get("exit_iface") and st.get("mode") != "node":
            self._set_hero("warn", "network-offline-symbolic", "Blocking everything",
                           f"{detail}\nNothing can leave until a permitted path "
                           "is back. This is the switch working.")
        else:
            core = detail.split(" — conflicting tunnel")[0]
            dns = DNS_PATH.get(str(st.get("dns_path")), str(st.get("dns_path")))
            self._set_hero("ok", "changes-prevent-symbolic", "Protected",
                           f"{core}  ·  DNS {dns}"
                           f"  ·  {st.get('hardening', '?')} hardening")

        self._rebuild_vpn_list()

        conflicts = str(st.get("conflicts") or "")
        prov = (armed and str(st.get("hardening")) == "paranoid"
                and self._cfg.get("hardening_confirmed") != "1")
        if prov:
            self.warn_banner.set_title(
                "Paranoid hardening is provisional — confirm while you still "
                "have a connection")
            self.warn_banner.set_button_label("Confirm")
            self.warn_banner.set_revealed(True)
        elif conflicts:
            self.warn_banner.set_title(
                f"Another tunnel is running: {conflicts}. It cannot reach its "
                "server while armed.")
            self.warn_banner.set_button_label("")
            self.warn_banner.set_revealed(True)
        else:
            self.warn_banner.set_revealed(False)

        n = len(self._pending)
        self.bar.set_revealed(n > 0)
        self.apply_label.set_label(
            f"{n} change{'s' if n != 1 else ''} staged — not in effect yet" if n else "")
        self._loading = False
        return False

    def _set_hero(self, tone, icon, title, subtitle):
        for w, classes in ((self.hero, ("ok", "bad", "warn", "off")),
                           (self.hero_icon, ("ok", "bad", "warn"))):
            for c in classes:
                w.remove_css_class(c)
        self.hero.add_css_class(tone)
        if tone in ("ok", "bad", "warn"):
            self.hero_icon.add_css_class(tone)
        self.hero_icon.set_from_icon_name(icon)
        self.hero_title.set_label(title)
        self.hero_sub.set_label(subtitle)

    # ---------------- actions ----------------
    def _on_arm(self, *_):
        if self._loading:
            return
        try:
            self.d.arm() if self.arm_switch.get_active() else self.d.disarm()
        except GLib.Error as e:
            self.toast(f"Failed: {e.message}")
        self._refresh()

    def _apply(self):
        try:
            self.d.apply()
            self.toast("Applied")
        except GLib.Error as e:
            self.toast(f"Failed: {e.message}")
        self._refresh()

    def _revert(self):
        try:
            self.d.revert()
            self.toast("Discarded")
        except GLib.Error as e:
            self.toast(f"Failed: {e.message}")
        while self.nav.get_navigation_stack().get_n_items() > 1:
            self.nav.pop()
        self._refresh()

    def _confirm_hardening(self):
        try:
            self.d.confirm()
            self.toast("Paranoid hardening confirmed")
        except GLib.Error as e:
            self.toast(f"Failed: {e.message}")
        self._refresh()

    # ---------------- pages ----------------
    def _page_mode(self):
        nodes = list(self.d.list_nodes())
        m = Adw.PreferencesGroup(
            title="Mode",
            description="Full is the kill switch. Node mode only pins DNS and "
                        "is not leak protection.")
        self._combo(m, "mode", "Mode", [
            ("full", "Full kill switch",
             "Nothing leaves except through the protected connection."),
            ("node", "Node access (DNS only)",
             "Internet stays open; only DNS is forced to the kiwi-node."),
        ])

        auto = self._val("auto_node", "0") == "1"
        n = Adw.PreferencesGroup(
            title="Trusted node",
            description="A kiwi-node that already tunnels for you can stand in "
                        "for the VPN on its own network, matched on IP and MAC "
                        "together. This is opt-in: with no node picked and the "
                        "switch below off, the VPN is always required.")
        nn = [""] + [x.get("name", "") for x in nodes]
        nlabels = ["None"] + [f"{x.get('name')} ({x.get('ip')})" for x in nodes]
        combo = Adw.ComboRow(title="Satisfied by this node")
        combo.set_subtitle("Overridden while “any node” is on" if auto
                           else "None means the VPN is always required")
        combo.set_model(Gtk.StringList.new(nlabels))
        cur = self._val("trusted_node")
        combo.set_selected(nn.index(cur) if cur in nn else 0)
        combo.set_sensitive(not auto)
        combo.connect("notify::selected", lambda w, _p: self._stage(
            "trusted_node", nn[w.get_selected()]))
        n.add(self._mark(combo, "trusted_node"))
        self._switch(n, "auto_node", "Accept any trusted node",
                     "Trust whichever configured node is the gateway. This "
                     "overrides the pick above.")
        return page("Mode and trusted node", m, n)

    def _page_dns(self):
        g = Adw.PreferencesGroup(
            title="Lookup policy",
            description="Applications always talk to the local resolver stub, "
                        "so what matters is where that stub forwards to. "
                        "Anything else is blocked outright.")
        self._combo(g, "dns_mode", "Send lookups", DNS_MODES)
        for value, _label, why in DNS_MODES:
            if self._val("dns_mode") == value:
                g.set_description(g.get_description() + "\n\n" + why)

        c = Adw.PreferencesGroup(
            title="Chosen resolver",
            description="Used when “A resolver I choose” is selected above. "
                        "Turn on DNS-over-TLS for a public resolver; leave it "
                        "off for one you own on a trusted path.")
        self._entry(c, "dns_custom", "Resolver address",
                    "An IP address, e.g. 9.9.9.9")
        self._switch(c, "dns_dot", "DNS-over-TLS",
                     "Encrypt lookups to that resolver")

        s_ = Adw.PreferencesGroup(
            title="Internal names",
            description="Extra routing domains, space separated — e.g. ~kiwi "
                        "sends *.kiwi lookups to the chosen resolver, so "
                        "internal names resolve the same at home and away.")
        self._entry(s_, "dns_search", "Routing domains", "e.g. ~kiwi")
        return page("DNS", g, c, s_)

    def _page_nodes(self):
        nodes = list(self.d.list_nodes())
        g = Adw.PreferencesGroup(
            title="Trusted kiwi-nodes",
            description="Gateways that already tunnel for you, so the VPN can "
                        "be skipped on their network. Matched on IP and MAC "
                        "together: MAC binding defeats a hostile network "
                        "handing out your router's address. It does not defeat "
                        "an attacker already on the wire forging a MAC — a "
                        "deliberate tradeoff, not an oversight.")
        add = Gtk.Button(icon_name="list-add-symbolic", valign=Gtk.Align.CENTER,
                         tooltip_text="Add node")
        add.add_css_class("flat")
        add.connect("clicked", lambda *_: self._edit_node(None))
        g.set_header_suffix(add)

        if not nodes:
            g.add(Adw.ActionRow(title="No nodes configured",
                                subtitle="Use + to add one"))
        for n in nodes:
            sub = f"{n.get('ip', '')}  ·  {n.get('mac') or 'any MAC (weaker)'}"
            if n.get("dns"):
                sub += f"  ·  DNS {n['dns']}"
            row = Adw.ActionRow(title=n.get("name", ""), subtitle=sub,
                                activatable=True)
            row.connect("activated", lambda _r, nd=n: self._edit_node(nd))
            dele = Gtk.Button(icon_name="user-trash-symbolic",
                              valign=Gtk.Align.CENTER)
            dele.add_css_class("flat")
            dele.add_css_class("error")
            dele.connect("clicked", lambda _b, nm=n.get("name"): self._delete_node(nm))
            row.add_suffix(dele)
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            g.add(row)
        return page("kiwi-nodes", g)

    def _edit_node(self, node):
        node = node or {}
        fields = {}
        box = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        box.add_css_class("boxed-list")
        for key, title in (("name", "Name"), ("ip", "Gateway IP"),
                           ("mac", "Gateway MAC"), ("dns", "Resolver on this node")):
            r = Adw.EntryRow(title=title, text=str(node.get(key, "")))
            fields[key] = r
            box.append(r)
        dlg = Adw.AlertDialog(
            heading="Edit node" if node else "Add node",
            body="Leave the MAC blank to match on IP alone — weaker, and any "
                 "network can then impersonate this node.")
        dlg.set_extra_child(box)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("save", "Save")
        dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)

        def done(_d, resp):
            if resp != "save":
                return
            try:
                self.d.write_node({k: w.get_text().strip()
                                   for k, w in fields.items()})
                self.toast("Saved")
            except GLib.Error as e:
                self.toast(f"Failed: {e.message}")
            self._repush(self._page_nodes)

        dlg.connect("response", done)
        dlg.present(self)

    def _delete_node(self, name):
        try:
            self.d.delete_node(name)
            self.toast(f"Deleted {name}")
        except GLib.Error as e:
            self.toast(f"Failed: {e.message}")
        self._repush(self._page_nodes)

