            ("network-workgroup-symbolic", "Mode and trusted node",
             "Skip the VPN on a gateway that already tunnels", self._page_mode),
            ("network-wired-symbolic", "kiwi-nodes",
             "Gateways that already tunnel for you", self._page_nodes),
            ("network-wireless-symbolic", "Reachable while armed",
             "LAN, bypass subnets, admin access", self._page_reach),
            ("security-high-symbolic", "Hardening",
