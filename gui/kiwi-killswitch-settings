class Daemon:
    """Thin synchronous D-Bus client for kiwi-killswitchd."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

    def _call(self, method, variant=None, reply=None):
        return self.bus.call_sync(DEST, OBJ, DEST, method, variant, reply,
                                  Gio.DBusCallFlags.NONE, 15000, None)

    def available(self):
        try:
            self._call("GetStatus", None, GLib.VariantType("(a{sv})"))
            return True
        except GLib.Error:
            return False

    def status(self):
        return dict(self._call("GetStatus", None,
                               GLib.VariantType("(a{sv})")).unpack()[0])

    def config(self):
        return self._call("GetConfig", None, GLib.VariantType("(a{ss})")).unpack()[0]

    def pending(self):
        return self._call("GetPending", None, GLib.VariantType("(a{ss})")).unpack()[0]

    def set_pending(self, key, value):
        self._call("SetPending", GLib.Variant("(ss)", (key, str(value))))

    def apply(self):
        self._call("Apply")

    def revert(self):
        self._call("Revert")

    def confirm(self):
        self._call("Confirm")

    def list_vpns(self):
        return self._call("ListVpns", None, GLib.VariantType("(a(sss))")).unpack()[0]

    def list_nodes(self):
        return self._call("ListNodes", None, GLib.VariantType("(aa{ss})")).unpack()[0]

    def write_node(self, node):
        self._call("WriteNode", GLib.Variant("(a{ss})", (node,)))

    def delete_node(self, name):
        self._call("DeleteNode", GLib.Variant("(s)", (name,)))

    def arm(self, vpn=""):
        self._call("Arm", GLib.Variant("(s)", (vpn,)))

    def disarm(self):
        self._call("Disarm")

    def watch(self, cb):
        self.bus.signal_subscribe(DEST, DEST, "Changed", OBJ, None,
                                  Gio.DBusSignalFlags.NONE, lambda *_: cb())


# ---------------------------------------------------------------------------
def page(title, *groups):
    pp = Adw.PreferencesPage()
    for g in groups:
        pp.add(g)
    tb = Adw.ToolbarView(content=pp)
    tb.add_top_bar(Adw.HeaderBar())
    return Adw.NavigationPage(child=tb, title=title)


class Window(Adw.ApplicationWindow):
    def __init__(self, app, daemon):
        super().__init__(application=app, title="Kiwi Kill Switch")
        self.set_default_size(620, 840)
        self.d = daemon
        self._loading = False
        self._cfg = {}
        self._pending = {}
        self._status = {}
        self._vpn_rows = []
        self._vpn_checks = []
        self._vpn_sync = False

        self.toasts = Adw.ToastOverlay()
        self.nav = Adw.NavigationView()

        # The apply bar lives OUTSIDE the navigation view on purpose: staged
        # changes belong to the whole configuration, not to the page you happen
        # to be looking at, and burying Apply on one subpage is how people end
        # up thinking a change took effect when it did not.
        self.apply_label = Gtk.Label(xalign=0)
        self.apply_label.add_css_class("dim-label")
        revert = Gtk.Button(label="Discard")
        revert.connect("clicked", lambda *_: self._revert())
        apply_btn = Gtk.Button(label="Apply")
        apply_btn.add_css_class("suggested-action")
        apply_btn.connect("clicked", lambda *_: self._apply())
        self.bar = Gtk.ActionBar()
        self.bar.pack_start(self.apply_label)
        self.bar.pack_end(apply_btn)
        self.bar.pack_end(revert)
        self.bar.set_revealed(False)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.nav.set_vexpand(True)
        box.append(self.nav)
        box.append(self.bar)
        self.toasts.set_child(box)
        self.set_content(self.toasts)

        self.nav.push(self._root_page())
        self.d.watch(lambda: GLib.idle_add(self._refresh))
        self._refresh()

    # ---------------- helpers ----------------
    def _reload(self):
        self._cfg = self.d.config()
        self._pending = self.d.pending()
        return self._cfg

    def _val(self, key, default=""):
        """The value the user should see: staged if staged, else active."""
        return self._pending.get(key, self._cfg.get(key, default))

    def _is_staged(self, key):
        return key in self._pending

    def _stage(self, key, value):
        if self._loading:
            return
        try:
            self.d.set_pending(key, "1" if value is True
                               else "0" if value is False else value)
        except GLib.Error as e:
            self.toast(f"Failed: {e.message}")
            return
        self._refresh()

    def _mark(self, row, key):
        """Show at a glance which rows are staged but not yet applied.

        Adw.EntryRow has no subtitle — it is not an Adw.ActionRow — so the
        marker degrades to the accent class and a tooltip there."""
        if not self._is_staged(key):
            return row
        row.add_css_class("accent")
        note = "Staged — not applied yet"
        if hasattr(row, "set_subtitle"):
            sub = row.get_subtitle() or ""
            if "not applied yet" not in sub:
                row.set_subtitle(f"{sub}  •  {note}".strip(" •"))
        else:
            row.set_tooltip_text(note)
        return row

    def _entry(self, group, key, title, tooltip=""):
        """Entry rows carry no subtitle, so the explanation for these lives in
        the enclosing group's description."""
        r = Adw.EntryRow(title=title, text=self._val(key))
        if tooltip:
            r.set_tooltip_text(tooltip)
        r.set_show_apply_button(True)
        r.connect("apply", lambda w: self._stage(key, w.get_text()))
        group.add(self._mark(r, key))
        return r

    def _switch(self, group, key, title, subtitle=""):
        r = Adw.SwitchRow(title=title, subtitle=subtitle)
        r.set_active(self._val(key, "0") == "1")
        r.connect("notify::active", lambda w, _p: self._stage(key, w.get_active()))
        group.add(self._mark(r, key))
        return r

    def _combo(self, group, key, title, options, subtitle=""):
        """options: [(value, label, explanation)]"""
        values = [o[0] for o in options]
        r = Adw.ComboRow(title=title, subtitle=subtitle)
        r.set_model(Gtk.StringList.new([o[1] for o in options]))
        cur = self._val(key)
        r.set_selected(values.index(cur) if cur in values else 0)
        r.connect("notify::selected",
                  lambda w, _p: self._stage(key, values[w.get_selected()]))
        group.add(self._mark(r, key))
        return r

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast.new(text))

    # ---------------- root ----------------
    def _hero(self):
        """A single, unmissable statement of what is happening right now.

        A kill switch has exactly one question — am I protected — and burying
        the answer in a subtitle is how people end up trusting a switch that is
        not actually enforcing anything."""
        self.hero_icon = Gtk.Image(icon_name="changes-allow-symbolic")
        self.hero_icon.add_css_class("ks-hero-icon")
        self.hero_title = Gtk.Label(xalign=0, label="Off")
        self.hero_title.add_css_class("ks-hero-title")
        self.hero_sub = Gtk.Label(xalign=0, label="", wrap=True, width_chars=34,
                                  max_width_chars=48)
        self.hero_sub.add_css_class("ks-hero-sub")

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                       hexpand=True, valign=Gtk.Align.CENTER)
        text.append(self.hero_title)
        text.append(self.hero_sub)

        self.arm_switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.arm_switch.connect("notify::active", self._on_arm)

        self.hero = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        self.hero.add_css_class("ks-hero")
        self.hero.append(self.hero_icon)
        self.hero.append(text)
        self.hero.append(self.arm_switch)
        g = Adw.PreferencesGroup()
        g.add(self.hero)
        return g

