# kiwi.manifest — app metadata for the kiwi updater
NAME=kiwi-killswitch
DESCRIPTION=Fail-closed VPN kill switch for GNOME on Silverblue — one VPN, no leaks, no password prompts
VERSION=0.1.0
AUTHOR=derlocke-ng
HOMEPAGE=https://github.com/derlocke-ng/kiwi-killswitch
LICENSE=GPL-3.0-or-later

COMPONENTS=daemon cli gui gnome-extension
CATEGORY=Security
TAGS=vpn killswitch firewall privacy wireguard openvpn nftables dns leak

SCOPES=user system
ROOT_REASON=installs a root firewall daemon, its D-Bus policy and two systemd units, so the rules survive reboots and load before the network does

ICON=
SCREENSHOTS=data/screenshots/1-protected.png data/screenshots/2-hardening.png data/screenshots/3-reachable.png
ABOUT=README.md
DEPENDS=nft ip nmcli python3

INSTALLER=install.sh
